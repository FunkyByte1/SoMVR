# headset-build9.env - the feature switches of VR build 9 for the user's headset session. At the freeze the
# coordinator copies (and edits) it to logs/build-vr9/headset.env next to the frozen build; scripts/som-vr-headset.sh
# reads that file (KEY=VALUE, one per line; only SOMVR_* keys; read and checked, never executed; see its header).
# The launcher adds its own keys itself: VK_LAYER_PATH, VK_INSTANCE_LAYERS, XR_RUNTIME_JSON (WiVRn), SOMVR_XR_LOG,
# SOMVR_SETTINGS (the user's menu settings file), SOMVR_TUNE. A headset.env next to the build also switches the launch
# to build 6's (no pre-game window, no distro box, scripts/cmds/somvr-vr6.cmd).
# Base: build 5d's set (scripts/som-vr-headset.sh's built-in list) without SOMVR_VIGNETTE=0 (the mod's 0.5 default:
# the user asked for a vignette); then build 6's helpers (logs/boot-check-20261023-155239, the merge boot without
# SOMVR_BODY=hands, which still shows Talion's head and body in the eyes).

# the pipeline, the view, the controls (build 5d)
SOMVR_STEREO=B
SOMVR_VIEWS=xr
SOMVR_COMFORT=1
SOMVR_XR=1
SOMVR_XR_DUMP=600
SOMVR_EYE_SIZE=xr
SOMVR_INPUT=1
SOMVR_POINTER=1
SOMVR_HUD=quad
SOMVR_AUDIO=head
SOMVR_BASE=head
SOMVR_HIDE_HEAD=parts
SOMVR_HEAD_PARTS=main
SOMVR_FALLBACK=auto
SOMVR_ARMS=1
SOMVR_ARMS_STRETCH=1
SOMVR_COMBAT=1
SOMVR_BLADE=controller
SOMVR_VRMENU=1
SOMVR_XR_ENV=on
SOMVR_ANCHOR=root
SOMVR_LOCO=1
SOMVR_LOCO_HOLD=attack
SOMVR_GAMEMOVES=off
SOMVR_COMBAT_REACT=1
SOMVR_CLIMB=b
SOMVR_THREAT=1
SOMVR_BODYMOMENTS=1
SOMVR_SLOTS=1
SOMVR_SLOTS_KEEP=attach
SOMVR_DEFENCE=1
SOMVR_PRACTICE=auto
SOMVR_PRACTICE_AT=32500,2100,-24800

# build 6: bug marks (hold B + Y, or the menu's Report) and the menu's Quit game (handoff/HANDOFF-launch.md)
SOMVR_MARK=1
SOMVR_QUIT=1
# the voice memo: 11 s asked = about 9.5 s recorded (headless, logs/boot-check-20261023-160221: parecord's start and the
# source's wake-up took 1.5 s of 9)
SOMVR_MARK_VOICE_S=11
# build 6: no boot movies (the game's own no-splash byte for the menu's init; logs/boot-check-20261023-165133: the main
# menu at +31 s instead of +55 s, the meadow at +90 s instead of +110 s; docs/re-launcher.md 8)
SOMVR_SKIP_SPLASH=1
# build 6: the sword in two hands (handoff/HANDOFF-hands.md); SOMVR_BODY=hands stays off for now
SOMVR_TWOHAND=1
# build 6: menus in front, the wrist minimap, the controls card, touch (handoff/HANDOFF-menus.md)
SOMVR_XR_MENU=front
SOMVR_XR_MINIMAP=wrist
SOMVR_MINIMAP=head
SOMVR_XR_CARD=on
SOMVR_XR_TOUCH=on
# the hands-only body (build 6 hands round 2, NOTES 17:05): Talion drawn again, everything but the hands folded away
SOMVR_BODY=hands
# build 7 (2026-10-24): the fingers on the controllers (grip = middle/ring/pinky, trigger = index, thumb on a touch; a
# held sword, dagger or hilt = a fist; handoff/HANDOFF-hands.md round 3; the Sword angle row in the wrist menu needs no
# switch); the sword fight (handoff/HANDOFF-combat.md): a parry = the orc's recoil, never the game's counter (the
# counter shows Talion's own back for 2-3 s, then moves the view 55-120 cm: the user's comfort rules)
SOMVR_FINGERS=1
SOMVR_DEFENCE_PARRY=recoil
# build 8 (2026-10-24): the HUD (handoff/HANDOFF-hud.md): the hit streak and the target panel join the minimap on the
# wrist watch; the prompts, hints, XP and place banners in one band 1.3 m ahead, 15 deg below the eyes (0.9 deg per
# 18-px line instead of 0.42). The parry's clank (handoff/HANDOFF-combat.md round 2): the orc's recoil picked from the
# parry/block/hit types, a 120 ms stop, a haptic crack, the game's spark (not seen yet); not `late` (never took).
# Defaults since build 8, no switch: the glance one tick per touch, the hit blade 100 cm (the model's tip), our hits'
# attack type (the orcs' blocks count).
SOMVR_XR_WRIST_HUD=on
SOMVR_XR_PROMPTS=on
SOMVR_DEFENCE_CLANK=recoil,stop,haptic,fx
# build 9 (2026-10-24): climbing works (handoff/HANDOFF-climb.md, re-xr-pipeline.md 32): SOMVR_CLIMB=b's new defaults
# need no line here (SOMVR_CLIMB_SURF=walls, SOMVR_CLIMB_TOP=push with the edge step SOMVR_CLIMB_RAMP=1,
# SOMVR_CLIMB_LOW_CM=50, SOMVR_CLIMB_FIGHT=hold); never SOMVR_CLIMB_TOP=lift|cmd or SOMVR_CLIMB_SURF=any.
# ---- build 10 (2026-10-24 evening, the user's build 9 session's 21 marks; handoff/HANDOFF-climb.md, -combat.md round 3,
# -comfort.md build 10, -vrhands.md, -scale.md; re-xr-pipeline.md 32.7-32.11, 30.12-30.19, 33, 34, 35)
# climbing: both hands open = Talion stays on the wall (A drops); the game's narrow-ledge mode off (the wall-top drift)
SOMVR_CLIMB_LETGO=hang
SOMVR_CLIMB_LEDGES=off
# comfort, sound, prompts: the vignette fitted to the lens; the music at 30 % (the VR menu's Music row); the flat game's
# combat hints dropped; Y held = the wraith vision
SOMVR_VIGNETTE_FIT=lens
SOMVR_MUSIC=0.3
SOMVR_HINTS=off
SOMVR_VISION=hold
# combat: the game's own draws refused (the sword stays on the back); the hands held to the controllers through a draw;
# the hit on Talion felt and seen (a pulse, a red edge); a block = the orc's weapon on the blade in its last 250 ms; the
# light stagger instead of the knockdowns
SOMVR_SLOTS_GAMEDRAW=refuse
SOMVR_ARMS_LW=held
SOMVR_HURT=1
SOMVR_DEFENCE_JUDGE=contact
SOMVR_COMBAT_KNOCKBACK=stagger
# our own hands (the WebXR generic hand, MIT), the watch flat on the back of the left wrist, the wrist menu off the palm
SOMVR_VRHANDS=1
SOMVR_XR_WATCH=wrist
SOMVR_XR_PANEL=palm
# the player size (the VR menu's Player size row, 100-140 % by 5, a blink at each change): 100 % as build 9 until the
# user picks one; at a bigger size the hands and the sword keep the player's own size
SOMVR_PLAYER_SIZE=100
SOMVR_SIZE_BODY=1
