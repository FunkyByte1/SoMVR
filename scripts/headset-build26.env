# headset-build26.env - the feature switches of VR build 26 (build 25's file at 19:40 10-29 with the missions block (285), + build 25's later blocks (above, nemesis - copied in by the coordinator), + the build 26 round's blocks at the end)
# Made from headset-build25.env on 2026-10-29 19:40 (the coordinator).
# scripts/som-vr-headset.sh
# reads that file (KEY=VALUE, one per line; only SOMVR_* keys; read and checked, never executed; see its header).
# The launcher adds its own keys itself: VK_LAYER_PATH, VK_INSTANCE_LAYERS, XR_RUNTIME_JSON (WiVRn), SOMVR_XR_LOG,
# SOMVR_SETTINGS (the user's menu settings file), SOMVR_TUNE. A headset.env next to the build also switches the launch
# to build 6's (no pre-game window, no distro box, scripts/cmds/somvr-vr6.cmd).
# Base: build 5d's set (scripts/som-vr-headset.sh's built-in list) without SOMVR_VIGNETTE=0 (the mod's 0.5 default:
# the user asked for a vignette); then build 6's helpers (logs/boot-check-20261023-155239, the merge boot without
# SOMVR_BODY=hands, which still shows Talion's head and body in the eyes).

# the pipeline, the view, the controls (build 5d)
SOMVR_STEREO=B
SOMVR_VIEWS=xr
SOMVR_COMFORT=1
SOMVR_XR=1
SOMVR_XR_DUMP=600
SOMVR_EYE_SIZE=xr
SOMVR_INPUT=1
SOMVR_POINTER=1
SOMVR_HUD=quad
SOMVR_AUDIO=head
SOMVR_BASE=head
SOMVR_HIDE_HEAD=parts
SOMVR_HEAD_PARTS=main
SOMVR_FALLBACK=auto
SOMVR_ARMS=1
SOMVR_ARMS_STRETCH=1
SOMVR_COMBAT=1
SOMVR_BLADE=controller
SOMVR_VRMENU=1
SOMVR_XR_ENV=on
SOMVR_ANCHOR=root
SOMVR_LOCO=1
SOMVR_LOCO_HOLD=attack
SOMVR_GAMEMOVES=off
SOMVR_COMBAT_REACT=1
SOMVR_CLIMB=b
SOMVR_THREAT=1
SOMVR_BODYMOMENTS=1
SOMVR_SLOTS=1
SOMVR_SLOTS_KEEP=attach
SOMVR_DEFENCE=1
SOMVR_PRACTICE=auto
SOMVR_PRACTICE_AT=32500,2100,-24800

# build 6: bug marks (hold B + Y, or the menu's Report) and the menu's Quit game (handoff/HANDOFF-launch.md)
SOMVR_MARK=1
SOMVR_QUIT=1
# the voice memo: 11 s asked = about 9.5 s recorded (headless, logs/boot-check-20261023-160221: parecord's start and the
# source's wake-up took 1.5 s of 9)
SOMVR_MARK_VOICE_S=11
# build 6: no boot movies (the game's own no-splash byte for the menu's init; logs/boot-check-20261023-165133: the main
# menu at +31 s instead of +55 s, the meadow at +90 s instead of +110 s; docs/re-launcher.md 8)
SOMVR_SKIP_SPLASH=1
# build 6: the sword in two hands (handoff/HANDOFF-hands.md); SOMVR_BODY=hands stays off for now
SOMVR_TWOHAND=1
# build 6: menus in front, the wrist minimap, the controls card, touch (handoff/HANDOFF-menus.md)
SOMVR_XR_MENU=front
SOMVR_XR_MINIMAP=wrist
SOMVR_MINIMAP=head
SOMVR_XR_CARD=on
SOMVR_XR_TOUCH=on
# the hands-only body (build 6 hands round 2, NOTES 17:05): Talion drawn again, everything but the hands folded away
SOMVR_BODY=hands
# build 7 (2026-10-24): the fingers on the controllers (grip = middle/ring/pinky, trigger = index, thumb on a touch; a
# held sword, dagger or hilt = a fist; handoff/HANDOFF-hands.md round 3; the Sword angle row in the wrist menu needs no
# switch); the sword fight (handoff/HANDOFF-combat.md): a parry = the orc's recoil, never the game's counter (the
# counter shows Talion's own back for 2-3 s, then moves the view 55-120 cm: the user's comfort rules)
SOMVR_FINGERS=1
SOMVR_DEFENCE_PARRY=recoil
# build 8 (2026-10-24): the HUD (handoff/HANDOFF-hud.md): the hit streak and the target panel join the minimap on the
# wrist watch; the prompts, hints, XP and place banners in one band 1.3 m ahead, 15 deg below the eyes (0.9 deg per
# 18-px line instead of 0.42). The parry's clank (handoff/HANDOFF-combat.md round 2): the orc's recoil picked from the
# parry/block/hit types, a 120 ms stop, a haptic crack, the game's spark (not seen yet); not `late` (never took).
# Defaults since build 8, no switch: the glance one tick per touch, the hit blade 100 cm (the model's tip), our hits'
# attack type (the orcs' blocks count).
SOMVR_XR_WRIST_HUD=on
SOMVR_XR_PROMPTS=on
SOMVR_DEFENCE_CLANK=recoil,stop,haptic,fx
# build 9 (2026-10-24): climbing works (handoff/HANDOFF-climb.md, re-xr-pipeline.md 32): SOMVR_CLIMB=b's new defaults
# need no line here (SOMVR_CLIMB_SURF=walls, SOMVR_CLIMB_TOP=push with the edge step SOMVR_CLIMB_RAMP=1,
# SOMVR_CLIMB_LOW_CM=50, SOMVR_CLIMB_FIGHT=hold); never SOMVR_CLIMB_TOP=lift|cmd or SOMVR_CLIMB_SURF=any.
# ---- build 10 (2026-10-24 evening, the user's build 9 session's 21 marks; handoff/HANDOFF-climb.md, -combat.md round 3,
# -comfort.md build 10, -vrhands.md, -scale.md; re-xr-pipeline.md 32.7-32.11, 30.12-30.19, 33, 34, 35)
# climbing: both hands open = Talion stays on the wall (A drops); the game's narrow-ledge mode off (the wall-top drift)
SOMVR_CLIMB_LETGO=hang
SOMVR_CLIMB_LEDGES=off
# comfort, sound, prompts: the vignette fitted to the lens; the music at 30 % (the VR menu's Music row); the flat game's
# combat hints dropped; Y held = the wraith vision
SOMVR_VIGNETTE_FIT=lens
SOMVR_MUSIC=0.3
SOMVR_HINTS=off
SOMVR_VISION=hold
# combat: the game's own draws refused (the sword stays on the back); the hands held to the controllers through a draw;
# the hit on Talion felt and seen (a pulse, a red edge); a block = the orc's weapon on the blade in its last 250 ms; the
# light stagger instead of the knockdowns
SOMVR_SLOTS_GAMEDRAW=refuse
SOMVR_ARMS_LW=held
SOMVR_HURT=1
SOMVR_DEFENCE_JUDGE=contact
SOMVR_COMBAT_KNOCKBACK=stagger
# our own hands (the WebXR generic hand, MIT), the watch flat on the back of the left wrist, the wrist menu off the palm
SOMVR_VRHANDS=1
SOMVR_XR_WATCH=wrist
SOMVR_XR_PANEL=palm
# the player size (the VR menu's Player size row, 100-140 % by 5, a blink at each change): 100 % as build 9 until the
# user picks one; at a bigger size the hands and the sword keep the player's own size
SOMVR_PLAYER_SIZE=100
SOMVR_SIZE_BODY=1
# build 11: the bow (the left trigger forms it; the right grip at the string nocks, pull, let go): the release shoots
# at once, the wraith body not drawn over our hands, the string on the string hand, the bow held upright
SOMVR_BOW=1
SOMVR_BOW_RELEASE=now
SOMVR_BOW_GHOST=nomat
SOMVR_BOW_STRING_POS=hand
# SOMVR_BOW_HOLD=auto (builds 11-15b: the bow flat along the arm in a real fist) - build 16: =fist in the bow16 block below
# build 11 bow round 2: the flat pad's prompts for commands no VR control sends hidden (Distract, Focus, Shadow Strike);
# the arrow aims at the head or chest nearest the bow line within 5 deg, else straight (no Shadow Strike while the bow
# is out in build 11: SOMVR_BOW_STRIKE=block, the default; build 12 below: dash)
SOMVR_PAD_PROMPTS=vr
# SOMVR_BOW_ASSIST_DEG=5 (build 19b; build 20 sets it in the som-b20-bow block)
# build 11: the world hides our hands where they go into it (the game's depth per eye)
SOMVR_XR_HANDS_DEPTH=world
# build 11: a killed orc drops where he stands (no death animation's 3-4 m slide); a block needs the sword hand to
# have moved 15 cm since the strike began (a sword held still no longer blocks)
SOMVR_COMBAT_DEATH=Block_Light
SOMVR_DEFENCE_CONTACT_MOVE_CM=15
# build 11: Celebrimbor's wraith (4 models on Talion's skeleton, seen in cover and while aiming the bow) hidden in the
# eyes while our VR hands replace the body; shadows keep it (handoff/HANDOFF-ghost.md)
SOMVR_HP_POSE=on
# ---- build 12 (2026-10-25, the wraith rounds and the execution; handoff/HANDOFF-wraith.md, -execute.md, -build12.md)
# the bow: X with the bow aimed at an orc = the game's Shadow Strike (when it shows its prompt, 2 arrows a strike); the
# view holds through the lunge, then a 0.3 s dash to the orc under a white-blue tunnel (no blink of the game's)
SOMVR_BOW_STRIKE=dash
# the wraith's wisps on our left hand (the hidden game hand turned and put on our wrist; the bow stays on the grip)
SOMVR_WISPS=hand
# a frame held away from Talion's body (the strike, a body moment's hold): all of him hidden, our arms on the
# controllers, our VR hands and the bow drawn
SOMVR_HP_AWAY=hands
# the execution: 8 hits without a 3 s gap = the game's charge (Urfael glows blue-white, one pulse); the right trigger
# held + a heavy hit = the game's instant kill (0.3x for 0.5 s, some records take the head); the defaults ride with it
# (SOMVR_EXECUTE_GLOW=game, _SEVER=key, _SLOWMO=0.3, _SLOWMO_MS=500, _DEATH=combat)
SOMVR_EXECUTE=1
# the execution's window for a VR player (round 2, handoff/HANDOFF-execute.md; the user's 10 s): the streak - and a full
# charge with it - lapses 10 s after the last hit instead of the game's 3 s (the game's own hit-counter timer, given a
# longer delay while the streak is up: you walk in with the stick, aim and swing for real; still 8 hits, and the orc's
# hits on you still reset it, as in the flat game)
SOMVR_EXECUTE_LAPSE_S=10
SOMVR_EXECUTE_READY_S=10
# the HUD's 3D flourishes (handoff/HANDOFF-hud.md, round 2): the hit streak's blue-white flare and the XP bar's cyan line
# were the game's UI FX drawn in the 3D world, head-locked at the far left of both eyes; not made in play now (the
# streak's `x N` stays on the wrist watch, the XP gains in the band; menus and flat frames keep theirs)
SOMVR_HUD_FX=hide
# ---- build 13 candidates: never a void (HG-9; handoff/HANDOFF-void.md, docs/re-xr-pipeline.md 36). The layer logs every
# gap of 100 ms or more between the game's presents without a switch (`xr: gap N`, SOMVR_XR_GAPS).
# the keep-alive: when the game stops presenting for 100 ms (a hitch, a load that stalls), the layer ends frames of its
# own at the headset's pace with live head tracking - the world's last frame held where it was (the runtime reprojects
# it) over the sky, or the sky and the last board - so the view never freezes to the head
SOMVR_XR_KEEPALIVE=on
# the loading space (needs SOMVR_XR_ENV=on): a stone floor under the sky at the real floor, our hands in every menu and
# load (from the controllers), a loading screen on a calm panel 2.4 m wide 2.4 m ahead (not the 0.6 m touch board) with
# the ember progress lights low ahead through the whole load and any stall; a stall in the world of 1 s fades to the
# space (not a frozen world through a load) and back through the fade
SOMVR_XR_LOADSPACE=on
# a stall is not a menu: a gap of 250 ms between the game's input ticks does not count toward the eye size's 2 s hold
# (without it a world stall over 2 s costs two mode sets after it: 1.6 s of flat, slow frames, boot 221150)
SOMVR_EYE_SIZE_STALL_MS=250
# the theatre: a video's flat frames (the story cutscenes) on a 5 m screen 5 m ahead, SOMVR_BODYMOMENTS' window (in-engine
# cinematics, captain presentations) on 3 m at 3 m, world-locked at eye height where the head faced, in the loading
# space; menus and loading screens keep the board. NOT SEEN AT RUNTIME YET (no video or window in a headless boot so far):
# the mock scenario only; the preload's somvr_session (SOMVR_MARK or SOMVR_QUIT) carries the word
SOMVR_XR_THEATRE=on
# ---- build 13 candidates (2026-10-25 night; the build 12 file grows into build 13's: one line per helper's round)
# the real-game drill (handoff/HANDOFF-drill.md): the practice's Go / Back asked for in the pause menu (the wrist menu
# opens there), at the Nemesis board after a death or in a scripted moment waits until the game is back for 1 s, the
# menu's buttons busy meanwhile (build 12: at once - its black hid the pause menu until the player unpaused blind; at
# the board its teleport landed in the respawn and left the game's black loading cover in front for 40-60 s)
SOMVR_PRACTICE_WAIT=1
# ---- build 13 candidate (2026-10-25, the user's climbing idea: "Gorilla tag inspired ... just let me sling myself up";
# handoff/HANDOFF-climb.md, re-xr-pipeline.md 32.14): let go of the wall while the hand still pulls fast = Talion flies
# on up the wall (only up, a little sideways: never away from the wall or down), catches a higher hold with a grip, or
# hangs where the throw tops out (no fall); a slow let-go hangs as before, A drops. Tunables (defaults):
# SOMVR_CLIMB_FLING_MIN=150 (cm/s up), _GAIN=1, _MAX=500 (cm/s), _SIDE=0.5, _G=981 (cm/s^2), _WIN_MS=100
SOMVR_CLIMB_FLING=on
# build 13, hands that stop at surfaces (docs/re-xr-pipeline.md 38, handoff/HANDOFF-surfaces.md; the HL:A gap HG-6):
# the hand you see and the sword in it stop at stone, wood and the ground (the game's own rays from the shoulder to the
# palm, the palm to the finger tips, along the blade); the IK arm, the drawn sword and the combat's blade follow the
# stopped hand, a faint wraith-blue ghost of the real hand shows once the two part by 4 cm; a tick at a hand's contact,
# the clank (and the defence's sparks when fast) at the blade's. Orcs' bodies never stop a hand or the blade (the hits
# land as before); never clamped: a climb's holding hand, the bow, the wrist panel, a pause, a finisher
SOMVR_HANDS_SURFACE=on
# never a void, round 2 (handoff/HANDOFF-void.md, docs/re-xr-pipeline.md 36.7-36.8): the game's in-world loading cover -
# after every fast travel (4-6 s) and a far respawn (40-60 s) the game puts opaque black with a spinner on its UI while
# the world goes on; build 12 showed it as a black slab with holes 1.5 m ahead. The layer reads a 16 x 9 grid of the HUD
# image each frame: the HUD, the band and the wrist minimap go as soon as it turns dark, and a cover held 300 ms
# (SOMVR_XR_COVER_MS) is a load - the world fades to the loading space with the ember progress lights and our hands, and
# back through the fade when the game lifts the cover (needs SOMVR_XR_ENV; the floor and the lights SOMVR_XR_LOADSPACE)
SOMVR_XR_COVER=on
# the in-world menus' backdrop: the pause menu, the map and their pages on the board over the live world get a dark
# panel behind the board (6 cm larger on each side, a soft rim) and the world dimmed 40 % (SOMVR_XR_MENU_BACK_DIM)
# behind it, rising over 0.12 s at the open (the drill's finding 4: Options unreadable over a forge tower's white marble)
SOMVR_XR_MENU_BACK=on
# ---- build 13 candidates (2026-10-26, the Nemesis verbs; handoff/HANDOFF-verbs.md, re-xr-pipeline.md 39)
# the left hand = the wraith hand, the game decides every outcome: reach to an orc's head or collar (or reach the arm out
# at it) and squeeze = the game's grab, held while the grip is closed, opened = let go; holding it, the left trigger =
# the drain (the brand where the game has it unlocked; this save: "NoBrand"); holding it, pull the orc to your face =
# the interrogation, then the trigger = Interrogate (the game's intel menu) or the sword into it = Eliminate; the sword
# into a held orc = the grab's own move; the trigger with the open hand on an orc's head = a tap the stun, held the
# combat drain; the sword on an orc the game offers its silent stealth kill for = that kill. The game's grab and
# interrogation are held first person (the body moments' hold, the view eased 35 cm back from the held orc's head);
# their prompts stay in the band with the game's words, their letters the Touch's that do the same (holding: X = the
# grab's move, A = the interrogation; its choice: B = Eliminate; the drain and Interrogate shown as LT, the left
# trigger); the bow does not take the left trigger meanwhile
SOMVR_VERBS=on
# build 13 candidate (2026-10-26, the verbs' glow; handoff/HANDOFF-verbs.md, re-xr-pipeline.md 39.7): the interrogation's
# pull brought the game's wraith flare on Talion's left hand (its FX domination_in / domination_loop) to ~25 cm from the
# eyes: a white-blue burst filling the middle of both eyes. hide = those two FX are not made while the game draws our
# eyes; the orc's own wraith glow (domination_brand_*), the wraith world and the drains' glow stay (the wraith at work).
# game = as built (the flare); SOMVR_VERBS_GLOW_FX=WORD,WORD names other FX to leave out
SOMVR_VERBS_GLOW=hide
# ---- build 13 candidate (2026-10-26, the drill's finding 1: a forge tower top had no way down; handoff/HANDOFF-climb.md,
# re-xr-pipeline.md 40): at an edge, reach over it and grip its lip (or the wall just under it): the climb starts from
# the top; push the hand up: Talion goes out over the edge and down the face, then hand over hand down (a hold pushed up
# lowers him, as climbing up); a light tick in the hand = the lip can be gripped. A while hanging (or holding the lip on
# the top) with the ground more than 4 m under his feet = a blink to it (the practice trip's fade: black, he stands
# there, back); lower = the real fall (no fall damage in this game); no ground under him or water = A does nothing (a
# double buzz). Tunables (defaults): SOMVR_CLIMB_BLINK_CM=400 (the blink from this high), SOMVR_CLIMB_LIP_DROP_CM=150
# (a lip: the ground beyond it this far under it), SOMVR_CLIMB_BLINK_MAX_CM=8000
SOMVR_CLIMB_DESCENT=on
# build 13 candidate (2026-10-26, HG-11: crouch by ducking; handoff/HANDOFF-crouch.md, docs/re-xr-pipeline.md 41): the
# player ducks for real (the head 28 cm below its height at the recentre for 0.15 s) and Talion goes into the game's
# stealth crouch (CombatSecondary04 held = PC_Stealth, the dagger); standing up (back above 18 cm below for 0.2 s, at
# least 0.5 s down) stands him up. The view drops by the real duck only (the root anchor: the game's crouch never moves
# it). The right stick down toggles the crouch (seated play keeps only that; the stock Crouch it sent in build 12 never
# did anything). A short pulse on both hands when he is down; the crouched walk at most 150 cm/s (SOMVR_CROUCH_CMS).
# The VR menu's Crouch row: Duck / Button. Tunables: SOMVR_CROUCH_DEPTH_CM, _UP_CM, _ON_MS, _OFF_MS, _HOLD_MS, _HAPTIC
SOMVR_CROUCH=duck
# ---- build 14 candidate (2026-10-26, HG-5: front-first enemies; handoff/HANDOFF-front.md, docs/re-xr-pipeline.md 42):
# the fight circle (the game's turn-taking) may no longer give an orc behind the player (out of the headset's 110 deg
# view) its attack at once: first it is warned for 1 s (the warning sound at that orc, the edge glow on its side
# rising, one pulse on that side's hand: a THREAT "pre" warning), then it may attack; orcs in view attack as before.
# Off = the flat game's choice (any orc of the circle, from behind too). log = the hooks only (logs, nothing changed).
# Tunables (defaults): SOMVR_FRONT_WARN_S=1.0, _READY_S=2.0, _QUIET_S=2.0, _VIEW_DEG=110 (THREAT's), _FAR_M=0 (all),
# _MAX_WARN=1. Off by default in the mod; on here
SOMVR_FRONT=1
# the AI's camera copy from the head (the game's "on screen" for the attacker score, the attacks that want their
# attacker on or off screen, the ambient spawner's off-screen spawns and the off-screen despawns): head = where the
# player looks (the headset's 110 x 90 deg), off = the flat game's hidden orbit camera (a 37 x 40 deg cone that swings on
# its own). head: the game itself then prefers the orcs in view, and spawns/despawns stay out of view (run 085304: none
# in view; with off, run 084439: 3 of 6 in the player's view; re-xr-pipeline.md 42.10)
SOMVR_FRONT_CAMCOPY=head
# the slot's lockout between two attacks x this (the game's 0.25 s re-arm, 0.75 s disarm): 1 = the game's
SOMVR_FRONT_LOCKOUT=1.0
# the attack damage at Talion x this (D10: 0.5 = half; amounts from 1000 on stay: scripted kills): 1 = the game's
SOMVR_FRONT_DAMAGE=1.0
# ---- build 14 candidate, front-first round 2 (2026-10-26, the threat14 helper; handoff/HANDOFF-front.md "Round 2",
# docs/re-xr-pipeline.md 42.11): THREAT's in-view test = FRONT's: the orc's bearing off the head (|yaw|), the pitch
# ignored (a close orc at Talion's feet is 50-77 deg below the eyes and seen: no more LATE edge warnings for it);
# full = round 1's full angle off the view direction (FRONT follows: one test)
SOMVR_THREAT_VIEW=bearing
# one warning per attack from out of view: FRONT's warning (the sound at the orc, one pulse on its side, the edge glow
# rising) is that attack's only sound and pulse; THREAT skips its own announce, sound and urgent pulse for it, and the
# edge glow stays on from the warning to the blow. 0 = round 1's (3 pulses and 2 sounds per blow from behind)
SOMVR_FRONT_ONECUE=1
# THREAT: an orc's "attack" with no key at all (no impact, no parry window, no hit frame, no shot) gets no cue: those are
# the orcs' moves between blows (run 092140, five orcs: 200 of 254 attack starts, none a blow, 114 of 148 out-of-view
# pulses and sounds). 1 = round 1's (a pulse and the sound for each of them out of view: a buzz storm in a crowd)
SOMVR_THREAT_KEYLESS=0
# build 14 candidate (2026-10-26, the story drill: handoff/HANDOFF-story.md, docs/re-xr-pipeline.md 43): B does what the
# flat pad's RB does at a story moment. A pick prompt ('Combat_Activate_*': an herb's "Restore Health", arrows; the game
# puts them on CombatSecondary02 123, which B never sent and the prompt band dropped) is shown with B's glyph and B
# picks; at a mission's marker B = "(RB) Start Mission" (QuestConfirm 282); while a presentation or a cinematic is up in
# the world (the mission card "(A) Accept (B) Cancel", a failed mission's "(A) Retry (B) Abandon") A, B, X, Y and the
# grips are the pad's buttons for the quest and skip commands only, each when the game has it active (a button held
# when the window opens counts after its release). Never a move, a jump or a combat command; nothing in a menu (the
# pad passthrough there already). Lines: USE ...
SOMVR_USE=1
# build 14 candidate (the story drill): a story video (a mission's start, `video=1`) comes as layout-B presents with no
# eye images, which build 13 answered with the last stereo frame again for the whole video (56 s frozen, the video only
# heard). With this switch they are mono frames: the video on the theatre's 5 m screen 5 m ahead (SOMVR_XR_THEATRE).
SOMVR_XR_THEATRE_VIDEO=on
# build 14 candidate (the story drill): the theatre places each new presentation, video or load again where the head
# faces now (build 13 kept the first window's place for every later window: one could come up behind the player).
SOMVR_XR_THEATRE_RESEAT=on
# ---- the story drill's round 2 (2026-10-26, handoff/HANDOFF-story.md "Round 2", docs/re-xr-pipeline.md 43.6-43.9):
# with SOMVR_USE the Controls page says "Use: B (pick, missions)" and keeps "Sprint: click left stick" (the crouch's
# line had pushed it off; the story's first objective is timed and its hint names the sprint): Menu and Pause share a line.
# The theatre's screens (a story video, a presentation: a captain's introduction, a mission card, a failed screen) are
# 1.33 x their distance wide: 4 m at 3 m, 6.65 m at 5 m (67 deg, was 53): a captain's line 0.8 deg instead of 0.6
# (logs/story2-pictures/theatre-size-*.png: the same frame at 3 and 4 m, at a Quest 2's pixel density). 100 = build 13.
SOMVR_XR_THEATRE_SIZE=133
# ---- build 15 candidate: the story's way-finding (2026-10-26, handoff/HANDOFF-objective.md, docs/re-xr-pipeline.md 44):
# the HUD's objective coin was placed by the game's flat 43 x 25 deg camera, so in VR it hugged the HUD quad's edge
# whatever the head did. With this switch the game's own marker (its nav marker 'Objective': the place the game shows)
# is drawn by the layer as a small gold diamond with the distance under it ("236 m"), world-locked over the objective's
# direction (4 deg, its quad at most 12 m away, faint within 5 deg of the view's centre); out of view a gold arrow at
# the view's edge points the way (5 deg, head-locked 1 m ahead). The game's coin is hidden in our stereo frames (the
# game's own hide). Nothing moves, nothing is pressed. SOMVR_OBJECTIVE=both keeps the game's coin too, =off as build 14.
SOMVR_OBJECTIVE=on
# ---- the collect drill (2026-10-26, handoff/HANDOFF-collect.md, docs/re-xr-pipeline.md 45): no new switch. An
# artifact's prompt shows only in the wraith vision near it (the game's rule): hold Y there, "(B) Pick Up" comes in
# 2-3 s (SOMVR_USE above keeps it and shows B), B picks it and opens its menu (A, the right stick, X, B, B, Start).
# Known open: that menu's artifact is not drawn in VR (our eyes stay in the world); Ithildin glyphs are not collected.
# ---- build 15b (the weapons helper, 2026-10-26, handoff/HANDOFF-weapons15b.md, docs/re-xr-pipeline.md 46): build 15's
# headset session lost the sword after the bow: the right stick's stealth crouch (latched during the bow) is PC_Stealth,
# which makes Acharn (slot 1) the active item, so the sword's draw was refused ("another weapon is active", DENIED) and
# Acharn hung in Talion's hidden hand ("my sword is floating in the middle of me"). With this switch the sword's draw
# (the player's or the restore after the bow) stands the stealth crouch up and activates melee first, and an active
# Acharn not in the left hand is not drawn in the eyes while the body is hidden. A kill's Acharn is still left alone.
SOMVR_SLOTS_STEALTH=on
# build 15b: the bow off the left trigger (the session's #6/#7: "when I grab the sword I should be pressing left
# trigger", "especially for climbing"): the bow hangs behind the left shoulder; the left grip pressed there brings it
# out and holds it while closed, let go there puts it back (let go elsewhere: the hands apart end it, as before). The
# string grip at the nock brings no bow any more. The left trigger counts as a grab (the climb's holds, the sword's
# hilt with both hands). The Controls page: "Bow: L grip at L shoulder". SOMVR_BOW_DRAW=trigger = build 15's.
SOMVR_BOW_DRAW=slot
# ---- build 15b candidate: smoother hands, a weighted sword (2026-10-26, handoff/HANDOFF-feel.md, docs/re-xr-pipeline.md
# 48). The user after build 15: the hands "a bit jittery ... mainly when holding the sword" and "add some 'weight' to
# the sword". No pipeline cause (the grips at the eyes' own time, the held sword not moved by the game); the shake is
# the controller's own, made visible by the 1 m blade. SOMVR_HANDS_SMOOTH=on: an adaptive (One Euro) filter on the grips,
# steady at rest (~2 Hz), no delay in a swing (4 ms at 172 deg/s, 1.3 ms at 573 deg/s); the drawn sword = the hits'
# blade. SOMVR_SWORD_WEIGHT=light: in fast swings only, the blade trails up to 3 deg and settles (heavy: 6 deg), a soft
# pulse on a fast swing, fuller hits; still or slow hands get nothing. Off: SOMVR_HANDS_SMOOTH=off / SOMVR_SWORD_WEIGHT=off.
# HANDJIT lines (every 10 s) measure the shake at the hand and the 1 m tip, raw and smoothed.
SOMVR_HANDS_SMOOTH=on
# (SOMVR_SWORD_WEIGHT: build 16 sets it in the sword16 block at the end)
# ---- build 15b, the loading voices (2026-10-26, handoff/HANDOFF-loadvoices.md, docs/re-xr-pipeline.md 47): session
# 165456 mark 11 "The voices I hear in the loading screen are kind of weird ... You might just want to turn them off".
# Through a load on flat frames the game's dialogue volume (its RTPC options_dialog) is sent as 0 and its own value
# back after the load; music and sound effects untouched. The game's voices in loads again: SOMVR_LOAD_VOICES=game.
SOMVR_LOAD_VOICES=off
# build 15b, the lip (handoff/HANDOFF-climb.md "build 15b", docs/re-xr-pipeline.md 47.2): session 165456 mark 8,
# stuck under a slab sticking out over the face. A pull the game blocks under a hold over the eyes goes out round the
# lip (at most 40 cm, SOMVR_CLIMB_OVERHANG_CM); a hold 50+ cm over a reached top forgets it; pulls held 0.4 s under a
# found top = descent's blink onto it. Off: SOMVR_CLIMB_OVERHANG=off.
# The coordinator, 10-26 18:30: off for 15b - proven in 1 of 2 boots, and its automatic blink onto the top breaks
# the user's rule for ability moves (a clear when, a known where, a cancel); on again once it's player-triggered.
SOMVR_CLIMB_OVERHANG=off
# build 16, the quit (the quit16 helper; docs/re-xr-pipeline.md 53, handoff/HANDOFF-launch.md "build 16"): 15b crashed
# at every exit() (the menus' Quit game, boot_check's SIGTERM) - the keep-alive called the runtime after the OpenXR
# loader unloaded it, Feral's crash reporter kept the game alive. At the exit our threads stop first (an exit handler),
# the hooks pass through, the runtime's library is pinned. Default on; off = build 15b.
SOMVR_XR_EXIT=on
# build 15b's follow-up (the weapons helper, after the 15b freeze; re-xr-pipeline.md 46.5): marks #4/#5 "they're not
# holding it right": the fist closed at the crossguard, the leather grip out behind it. The drawn sword slides 8 cm ahead
# along its blade in the right fist (the right weapon node's calibration, before the sword angle), so the fist closes on
# the leather right under the guard; the combat blade's tip 8 cm farther with it (what you see is what hits). The two
# hands' grab is unchanged (the left hand 8..24 cm behind the right grip: on the leather toward the pommel). 0 = build 15.
SOMVR_SWORD_GRIP_CM=8
# ---- build 16, the sword's weight (the sword16 helper; docs/re-xr-pipeline.md 52, handoff/HANDOFF-feel.md "build 16"):
# session 233334 mark 6: the sword needs more weight (light's trail let it be wiggled freely with one hand). Heavy
# (Blade & Sorcery's feel): one hand, the blade's direction follows the hand through an acceleration limit - slow cuts 1:1, fast cuts trail 11-16 deg and catch up in 0.1-0.3 s, a quick 5 Hz wiggle moves the blade a third as much;
# the twist and the hand stay 1:1; both hands on the hilt near 1:1; a drag pulse, fuller hits. The VR menu's Sword weight
# row (Off / Light / Heavy) changes it live. Build 15b's: light (its 3-degree trail). Off: SOMVR_SWORD_WEIGHT=off.
SOMVR_SWORD_WEIGHT=heavy
# build 16 (the sword16 helper): the right grip each frame the weight applies into <somvr.log>.swordrec (text, ~5 KB/s
# while the sword is drawn, at most 48 MB) - the user's own swings and wiggles, replayed offline through every weight
# level (tests/test_smooth.c SWG_REPLAY=FILE) to tune the next build. Off: SOMVR_SWORD_REC=off.
SOMVR_SWORD_REC=on
# build 16 (the sword16 helper): the drawn hands with the weighted blade - fixed (the hands stay on the controllers, the
# handle turns in the fist by up to 16 deg in a fast heavy cut) or follow (the layer's hands turn with the blade about
# their grips, the fist stays closed on it; positions and the twist stay 1:1). Fixed: never laggy hands.
SOMVR_SWORD_WEIGHT_HAND=fixed
# ---- build 16: the wraith round (the wraith16 helper, 2026-10-27; handoff/HANDOFF-wraith.md "build 16", docs/
# re-xr-pipeline.md 49). Y and the wraith vision (SOMVR_VISION=hold above) is fixed in the code: a press with the vision
# on turns it off, Y not held while it is ours turns it off, the taps wait out the game's ~1 s dwell. The weapons' glowing
# wraith copies: the ones of a weapon hidden in the eyes (the sheathed sword, the dagger, in the vision and the bow's aim)
# are hidden too; the held weapon's glow stays. Off: SOMVR_HP_COPIES=off (build 15b).
SOMVR_HP_COPIES=on
# ---- build 16, the bow (the bow16 helper, 2026-10-27, handoff/HANDOFF-bow.md "build 16", docs/re-xr-pipeline.md 51):
# session 233334 mark 1, the bow lay flat along the arm: builds 11-15b laid its shot on the grip's +Z, the fist's tube -
# up for a real bow hold (that session's idle ray (-0.087 0.981 0.176)). HOLD=fist: the limbs along the fist, the shot
# along the arm, the string toward the face, the bow's own grip in the hand (this line replaces SOMVR_BOW_HOLD=auto above;
# the later line wins). The string on the right trigger: RT at the string nocks, pull with it held, let go of RT = the
# shot. The quiver: RT behind the right shoulder (the sword's place; the sword's grip there only while the bow is away)
# takes an arrow (seen in the hand, drawn by the layer); touched to the string it is nocked; let go before that it is
# gone; let go below 20 cm of draw it rests on the string; none left = nothing and a buzz. The Controls page: "Arrow: RT
# at R shoulder", "Shoot: nock, pull, let go". Our shot's arrow is ImmediateImpact (never drawn): the layer draws it
# flying on at 70 m/s (SOMVR_BOW_FLIGHT_MPS, the default). Our shot had no sound (the stock one comes with its
# animation): the stock shot's own events, found with SOMVR_BOW_SNDLOG - the draw's creak at the nock (cut at the
# release) and the bow's fire at the release, from the bow hand. Back to build 15b's: HOLD=auto, STRING=grip,
# QUIVER=off, SOUND and DRAW_SOUND off.
SOMVR_BOW_HOLD=fist
SOMVR_BOW_STRING=trigger
# SOMVR_BOW_QUIVER=on (build 19b; build 20 sets it in the som-b20-bow block)
SOMVR_BOW_SOUND=wra_bow_fire_plyr
SOMVR_BOW_DRAW_SOUND=wra_bow_damage_draw
# ---- build 16, the climb16 helper (handoff/HANDOFF-climb.md "build 16", docs/re-xr-pipeline.md 50): session 233334
# marks 2/3, pinned at the meadow bank's lip (held as if in a ledge state). UNPIN: Talion's capsule caught in the rock (the proxy's own
# contacts inside a wall), every level move undone: the asked move (the stick's, a pull's; at most 8 cm a tick) given
# to the proxy, never into what he touches or toward a wall. PULLOVER: where the climb is blocked at a top's edge with
# room for him on the top, a ring shows there; that hand pulled 25 cm = a quick blink onto it; opening the hand cancels
# (no room: a soft double buzz). HANG_STICK_CM:
# hanging with the feet at most 60 cm over the ground, the stick = he stands and walks. Off: =off / =0.
SOMVR_CLIMB_UNPIN=on
SOMVR_CLIMB_PULLOVER=on
SOMVR_CLIMB_HANG_STICK_CM=60
# combat16 helper (handoff/HANDOFF-combat.md "build 16", docs/re-xr-pipeline.md 54): the infantry's overhead chop lands at
# its sibling strikes' reach and no orc walks into Talion (90 cm from his root); a committed edge-leading cut is the
# game's Medium strike (its High one, the shield breaker, from a hit streak of 8) and a raised shield glances it; a hit
# that would leave an orc 12 health or less kills it (an orc left at a sliver stopped fighting).
SOMVR_FIGHT_REACH=AI_Infantry_Melee_Front_3_LL:65..85
SOMVR_FIGHT_SPACE_CM=90
SOMVR_COMBAT_CLASS=cut
SOMVR_COMBAT_SLIVER=12
# ---- build 16 round 2, the climb2 helper (handoff/HANDOFF-climb.md "build 16 round 2", docs/re-xr-pipeline.md 50.8-50.9):
# THROUGH: a pull blocked under a hold over the eyes (the capsule held under a lip it cannot pass) goes up through the
# rock 1:1 with the hand, as the game's own wall run passes it; never with rock at or round the head (rays). Off: =off.
# FACE_TOWARD: a hold taken with the palm or the fingers along the wall uses the wall's own direction (no early "over"
# with the feet still under a top). Off: =off.
SOMVR_CLIMB_THROUGH=on
SOMVR_CLIMB_FACE_TOWARD=on
# The arrow seen is the game's own glowing arrow: it rides Talion's right weapon node while the bow is out (the wraith
# round found it), so that node now follows the quiver - in the hand, nocked, drawn, resting on the string, flying on
# after the shot - and is put away out of sight with no arrow taken (the layer's own arrow only with this off).
SOMVR_BOW_GAME_ARROW=on
# combat16 round 2 (re-xr-pipeline.md 54.8): the space kept from the player's head too (the nearer of the head and
# Talion's root: leaning or stepping in no longer lets an orc into the face); the shield physical, B&S-style: a cut
# whose blade meets the shield (a 40 cm sphere about its model) before the body glances with the clank, one around it
# (low, high, its open side) lands - against a lone shield orc the angle rule left nothing that works in VR.
SOMVR_FIGHT_SPACE_FROM=head
SOMVR_COMBAT_SHIELD=physical
SOMVR_COMBAT_SHIELD_CM=40
# ---- build 17, the climb17 helper (handoff/HANDOFF-climb.md "build 17: top-outs", docs/re-xr-pipeline.md 60):
# HUG: while climbing, a hand pushed toward the wall never shoves him off it (the move away from the face is cut once
# his root is 50 cm from the hold's face); further out a pull takes him back toward it. Off: =off.
# STAND: at a top, a floor under his capsule = letting go stands him on it (and a push that brings his feet onto it
# ends the climb); a topped hang with his capsule's rim on the top: the stick walks him onto it. Off: =off.
# HEAD_ROCK: the head within 8 cm of a surface fades the view, black 2 cm past it; black 0.5 s = the view back at
# Talion's eyes; also at any of our blinks' black (the drift of real steps dropped). =fade: the fade only; =off.
# TOPOUT: at a top with the head over it, a push the game's collision holds at the edge's corner goes through the rock
# 1:1 (the head's way kept clear by rays; the ring stays the fallback). Off: =off.
# FOLLOW (the build-5 body follow, off since build 4b): the session's real steps left the eyes 64-104 cm off Talion's
# root (the orcs aim at the root: every blow landed in front of the player); now his root follows the head's ground
# position once it is 20 cm off, at most 4 cm a frame (3.6 m/s at 90 Hz), with the game's collision; the view does
# not move (the rig's origin takes the move), no body is drawn. Off: SOMVR_FOLLOW=0.
SOMVR_CLIMB_HUG=on
SOMVR_CLIMB_STAND=on
SOMVR_CLIMB_TOPOUT=through
SOMVR_HEAD_ROCK=on
SOMVR_FOLLOW=1
SOMVR_FOLLOW_CM=20
SOMVR_FOLLOW_STEP_CM=4
# ---- build 17, the menu17 helper (docs/re-xr-pipeline.md 56, handoff/HANDOFF-menus.md "build 17"): no new switches.
# The VR menu's Sword hand row (Fixed / Follow = SOMVR_SWORD_WEIGHT_HAND live) and Arrows row (Quiver / Auto =
# SOMVR_BOW_QUIVER live, taken while the bow is away) start from the lines above (fixed, on); the Controls page's lines
# follow them (Block, 2 hands, Dagger, Ledge added; 21 lines). The practice page's Refill arrows + focus and Refill
# health buttons need nothing but SOMVR_PRACTICE (their three read-only calls are byte-checked at start).
# ---- the collectibles (the collect drill's round 2, the inspect16 helper, 2026-10-26/27; handoff/HANDOFF-collect.md
# "Round 2", docs/re-xr-pipeline.md 45.7-45.10). SOMVR_INSPECT=on: while the game is paused in a menu whose picture
# comes from a camera of its own (580-600 m under the map: an artifact's inspect view, Sauron's Army's captains, the
# Appendices' walls) those frames render flat from the game's camera on the menu board (the same 0.72 m board, where
# the menu opened; nothing moves with the game's camera): the artifact in front of the player, the sticks turn and zoom
# it, "(X) Play Memory" when its memory point is found, X plays the memory (its voiced verse on the board). Build 16
# showed the world at Talion's head there (the object never seen). The pause menu's own page shows the flat game's
# scene behind its text too. Two mode sets (~150 ms each) at each such menu's start and end. off = build 16.
SOMVR_INSPECT=on
# SOMVR_HINTS=off dropped the game's own collectible tutorial, shown once near an artifact or an Ithildin ("Enter the
# Wraith World (LB) to find the nearby Ithildin." - the pad's glyph; our Y): with this its key's hints pass, the fight's
# button hints stay dropped. Unset = build 16.
# SOMVR_HINTS_KEEP=Tut_Collectible_ (build 19b; build 20 drops it in the som-b20-bugs block)
# The UI texts' button icons (tutorials, hints, tips): the game draws an action's icon from the flat pad's binding, so
# the wraith vision (CombatSecondary01 122) showed LB; in VR it is held on Y: with this its icon is the pad's Y (the
# icon of CombatPrimary02 119) - "Enter the Wraith World (Y) ...". The binding itself is untouched. Unset = build 16.
# SOMVR_TEXT_BUTTONS=122:119 (build 23; build 24 sets it in the som-b24-brand block)
# A game menu opened while the head looks down (an artifact's pick at the feet) gets its board down the gaze, at most
# 30 deg below the level (still facing the eyes, where it opened; looking up keeps the level board). 0 = build 16.
SOMVR_XR_MENU_PITCH=30
# ---- build 17, the descent17 helper (handoff/HANDOFF-climb.md "build 17: the drop's marker", docs/re-xr-pipeline.md 55):
# A at an edge or on a wall no longer blinks Talion down at once: A held shows where he will land (a gold ring on the
# ground, a faint line from the edge down to it; nowhere safe - no ground, water, an orc there, no room - = no ring and a
# soft double buzz), A let go after 0.3 s goes there under a quick fade (0.42 s nominal), the move stick while A is held
# cancels (and walks only once let go and pushed again), a shorter tap does nothing. Controls page: "Drop: hold A, let
# go". Off: =off (A blinks down at once, as build 16). The hold: SOMVR_CLIMB_DESCENT_MARK_HOLD_MS (default 300).
SOMVR_CLIMB_DESCENT_MARK=on
# bow17 helper (build 17, docs/re-xr-pipeline.md 61): the bow's nock anywhere near the string's middle (25 cm) with the
# draw counted behind it; a double buzz for an empty hand at the string (three knocks: the quiver empty); the game's
# crosshair never shown (the arrow is the aim); our hands 20 % bigger round the sword's and the bow's grips; the wraith
# look's lighting ramps in/out in 0.15 s, not the game's 1 s (the vision record, also the bow's aim).
SOMVR_BOW_NOCK_ZONE=string
SOMVR_BOW_NOARROW_CUE=buzz
SOMVR_BOW_RETICLE=hide
SOMVR_XR_HANDS_SIZE=1.2
SOMVR_VISION_RAMP_MS=150,150
# ---- build 17, the block17 helper (handoff/HANDOFF-combat.md "build 17: blocking", docs/re-xr-pipeline.md 62): the
# build-16 session's "I can't figure out how to block these attacks". Blows DEFENCE never blocks (cannot-block, cannot-
# parry, and now cannot-counter: the defender's spear sweeps, the flat game's red prompt) are told at their wind-up: the
# orc's weapons and body glow red and pulse, out of view the edge is red, three buzzes in both hands then a double just
# before the impact, a warning sound; the way out: step/lean 30 cm aside or 40 cm back, or A = a 1.5 m dodge (the left
# stick's direction, else straight away from the attacker; the wraith tunnel; never into a wall or off a ledge: refused
# with a double buzz; 0.5 s cooldown). A block counts with either the drawn (weighted, trailing) blade or the blade where
# the hand holds it, its centre within 15 cm of the orc's weapon, the guard moved 15 cm (grip or tip). The glows sit on
# the orc's weapons (a berserker's two: the striking one brighter). In a fight with the sword in hand the climb takes no
# new hold (a grip by a wall put the sword away: "my sword clips around"). Off: each switch's =off / the old values.
SOMVR_THREAT_RED=on
SOMVR_THREAT_AT=weapon
SOMVR_DEFENCE_RED_TYPES=parry,counter,block
SOMVR_DEFENCE_CONTACT_BLADE=both
SOMVR_DEFENCE_CONTACT_MOVE_FROM=blade
SOMVR_DEFENCE_CONTACT_CM=15
SOMVR_DEFENCE_KEEP_SWORD=on
SOMVR_DODGE=on
# build 17b (the coordinator's run 161759: dashes pressed in time judged by the head's place at the impact): the A
# dodge's press commits - a blow landing 50..500 ms after it is dodged (its dash runs on, out of the blow). Off: =0.
SOMVR_DODGE_GRACE_MS=500
# stagger17 helper (build 17; docs/re-xr-pipeline.md 58): an orc we hit or parry reels back at most this far from where
# the hit found it (1:1 to half of it, then slowing to a stop; a step toward Talion free, FIGHT_SPACE's 90 cm after it)
# instead of =stagger's 1.4-1.9 m and the walk back; 0 = measured only (`COMBAT reel` lines)
SOMVR_COMBAT_STAGGER_CM=55

# build 17, the strike17 helper (docs/re-xr-pipeline.md 63, handoff/HANDOFF-wraith.md "build 17"): the Shadow Strike by
# gaze - in the wraith vision (Y held) the orc the head looks at is marked (a wraith-blue ring round it, "A Shadow
# Strike" beside it; grey "No arrows" under 2 arrows); A = the game's own strike at it with build 12's wraith dash;
# looking away or letting go of Y first = nothing. Needs SOMVR_BOW_STRIKE=dash, SOMVR_BOW=1, SOMVR_VISION=hold (above).
SOMVR_STRIKE_GAZE=on
# ---- build 17, the bite17 helper (docs/re-xr-pipeline.md 59, handoff/HANDOFF-feel.md "build 17: the bite"): a full
# cut that lands bites - the drawn blade stops in the orc where it went in (the hand moves on: the handle turns in the
# fist) for at most 60 ms, or until it is 30 deg off (a fast cut tears free sooner), then eases back onto the hand over
# 100 ms; a full pulse while it bites and a short beat when it comes free (no ring: that is the block's clank). Taps,
# flat slaps and stabs never bite. The VR menu's "Blade bite" row turns it off and on. Off: SOMVR_COMBAT_BITE=off.
SOMVR_COMBAT_BITE=on
# (SOMVR_COMBAT_BITE_MS / _EASE_MS / _DEG: build 18 sets them in the sword18 block at the end - was 60 / 100 / 30)
# Each landed hit kind sounds its own over the game's hit sound (the game's own events, at the contact): a cut a heavy
# body impact, a flat slap a thin knock, a stab the blow-on-a-body thud (a tap as a slap); a cut shows blood and a stab
# sparks at the contact (the game's FX). Off: SOMVR_COMBAT_HITSND=off / SOMVR_COMBAT_HITFX=off.
SOMVR_COMBAT_HITSND=on
SOMVR_COMBAT_HITFX=on
# ---- build 17, the nomove17 helper (handoff/HANDOFF-combat.md "build 17: no game moves of the player",
# docs/re-xr-pipeline.md 64): an enemy's paired sync on Talion (the berserker's headbutt after a Medium hit on it, its
# bodyslam, the defender's wrecker, the throat grab, the captains' counters) plays in place: LOCO keeps his ticks, the
# game's root motion goes (build 16: the headbutt carried him and the view 86 cm); the blow, the damage, the red flash
# and the buzz stay. Off: =off.
SOMVR_COMBAT_HOLD_TALION=on
# ---- build 18, the block18 helper (handoff/HANDOFF-combat.md "Build 18: the dodge", docs/re-xr-pipeline.md 62.7): blows
# that land under 0.45 s after their red warning (the defender's ShieldBash 0.234 s, the berserker's Bash 0.266 s: no
# time to react) are held up to 0.4 s at their impact - an A dodge pressed since the blow began, or the head out of it
# by then, dodges it; else it lands then. The A dodge is refused with the buzz while the game holds Talion (a sync, a
# lock: the dash could not move). Off: SOMVR_DODGE_FAST_MS=0.
SOMVR_DODGE_FAST_MS=450
SOMVR_DODGE_HOLD_MS=400
# The game's counter icon (the flare with the button over an attacking orc, "Y") is not made in VR - the user's "hide
# it for now": THREAT's glows and the red warning are the cues. Off: SOMVR_COUNTER_ICON=game.
SOMVR_COUNTER_ICON=hide
# ---- build 18, the menu17 helper (far18; docs/re-xr-pipeline.md 56.9, handoff/HANDOFF-menus.md "build 18"): the practice
# page's "Spawn far orc (unaware)" puts the orc this far ahead (on ground the ray finds within 6 m nearer .. 2 m farther,
# straight ahead or 15 deg aside) with its back to Talion: it notices him only as the game's senses would (seen, heard,
# hit) - for the Shadow Strike, the bow and the stealth kill. 800..4000; the plain Spawn stays SOMVR_PRACTICE_AHEAD_CM.
# SOMVR_PRACTICE_FAR_CM=1800 (build 19b; build 20 sets it in the som-b20-finish block)

# build 18, the strike18 helper (docs/re-xr-pipeline.md 63.8): after a Shadow Strike the game keeps its knockdown's sync
# record; LOCO now treats a record the fallback's stale rule gives up on as no sync (it owns Talion again ~1 s after his
# part ends), and the wraith vision is lit again when an orc's hit ends it while Y is still held. Both default on.
SOMVR_LOCO_SYNC_STALE=on
SOMVR_VISION_RELIGHT=on
# build 18, the wraith step (the wstep18 helper; docs/re-xr-pipeline.md 68, handoff/HANDOFF-wraith.md): the right stick
# pushed forward and held aims a short blink with the head's ray - a gold ring on the ground where Talion will land, up
# to 7 m (red and crossed = not there: a wall, a ledge, water, no room, an orc there) - let go = the quick blink onto
# it (the drop mark's fade), the move stick while aiming = cancel; the next after 1 s, no game cost. Off: =off.
SOMVR_WRAITH_STEP=on
# glyph18 helper (build 18, docs/re-xr-pipeline.md 45.13): the Ithildin collected by looking at it - near a glyph,
# hold Y (the wraith vision) and look at the glow: when the game's own look test passes with our head, the glyph is
# collected by the game's own item Collect (no attack, no animation, the view stays ours) and the game opens its
# Ithildin page on the menu board. Off: =off (build 17: never collected).
SOMVR_GLYPH=head
# ---- build 18, the climb18 helper (handoff/HANDOFF-climb.md "build 18: the fling", docs/re-xr-pipeline.md 60.8):
# FLING_UP: the fling up first - the cap on the up part alone (650 cm/s: 2.15 m up), the push into the wall mostly
# turned up the face (a quarter kept, half the rest up), sideways x 0.7 (at most 0.6 of the up), from 110 cm/s up,
# the release x 1.15; never away from the wall, a slow let-go still hangs. Off: =off (and the four numbers out).
SOMVR_CLIMB_FLING_UP=on
SOMVR_CLIMB_FLING_MAX=650
SOMVR_CLIMB_FLING_MIN=110
SOMVR_CLIMB_FLING_GAIN=1.15
SOMVR_CLIMB_FLING_SIDE=0.7
# bow18 helper (build 18, docs/re-xr-pipeline.md 61.9): our own bow string on the layer while nocked/drawn (both sides; the game's at rest);
# the arrow from the quiver held at our hand's thumb-index pinch.
# (build 19: SOMVR_BOW_STRING_DRAW and SOMVR_BOW_STRING_TIPS_CM in the bow19 block at the end; build 18's =drawn, 35)
SOMVR_BOW_ARROW_HOLD=pinch
# ---- build 18, the sword18 helper (docs/re-xr-pipeline.md 66, handoff/HANDOFF-feel.md "build 18"): the fist on the
# handle and a bite you feel. The fist closes round a 3.4 cm handle (build 17's fingertips reached the hilt's axis: the
# handle ran through the fingers even held still); the drawn hands turn with the drawn blade - the weight's trail and the
# bite - so the handle never turns in the fist (it supersedes SOMVR_SWORD_WEIGHT_HAND; the menu's Sword hand row goes);
# with both hands the left fist stays on the leather (10.5..13 cm behind the right grip, not on the pommel). A landed
# cut's blade drags through the orc at most 35 deg behind for 90 ms (build 17's tore free in 2-24 ms), eases back over
# 110 ms, and a full-strength thud for the hold with a separate tear after it. Off: SOMVR_XR_HANDS_GRIP_CM=0,
# SOMVR_SWORD_HAND_LOCK=off, SOMVR_TWOHAND_HOLD_CM=8,24, SOMVR_COMBAT_BITE_DRAG=off, SOMVR_COMBAT_BITE_HAPTIC=pulse and
# build 17's 60 / 100 / 30.
SOMVR_XR_HANDS_GRIP_CM=3.4
SOMVR_SWORD_HAND_LOCK=on
SOMVR_TWOHAND_HOLD_CM=10.5,13
SOMVR_COMBAT_BITE_MS=90
SOMVR_COMBAT_BITE_EASE_MS=110
SOMVR_COMBAT_BITE_DEG=35
SOMVR_COMBAT_BITE_DRAG=on
SOMVR_COMBAT_BITE_HAPTIC=thud
# ---- build 18, the parry18 helper (handoff/HANDOFF-combat.md "build 18: the parry", docs/re-xr-pipeline.md 65): a block
# that meets the orc's blow is a parry: a clang at the blades, a pulse in the free hand, +1 on the hit streak, and the
# orc is open for 1 s - its own block stops nothing, and a full cut then is the game's strongest strike (meant to break
# a raised shield too: not proven headless yet). Off: SOMVR_PARRY=off. (The left-hand shove that opens a shield orc, SOMVR_SHOVE=on, is not proven
# headless yet: off for build 18.)
SOMVR_PARRY=on
# ---- build 18, the stealth18 helper (handoff/HANDOFF-stealth.md, docs/re-xr-pipeline.md 67): the VR stealth kill.
# Crouched (the real duck) or slow, behind an orc that has not noticed Talion (the game's own awareness), the sword (or
# Acharn, the dagger: the left hip slot) driven into its back or neck - a hit or a firm stab - kills it at once and silently (the
# stock silent stealth kill's record, the body drops where it stands; no paired animation: neither Talion nor the view
# moves). A soft tick in the sword hand when an orc can be killed so; an orc that noticed Talion is a normal fight.
# Off: =off. Tunables: SOMVR_STEALTH_KILL_STANCE=either|crouch|slow, _BEHIND_DEG, _SLOW_CMS, _STAB_MPS, _CUE (0 = no tick)
SOMVR_STEALTH_KILL=on
# tether18 helper (build 18, re-xr-pipeline.md 69): the follow's measure fixed (mark 6's view off the edge), the head tether
SOMVR_FOLLOW_MEASURE=along
# (the build 18 integrator, 20:35) off for the freeze: its condition boot (tether18-drive.sh edge6 flat wall on the
# merged build, run 20261027-202648) never measured - TETHER END frames 2346, not measured 2346 (the reason is not
# logged unless a fade is up). The follow's measure fix (along, the default in the code) stays on.
# SOMVR_HEAD_TETHER=off (build 18; build 19 turns it on in the tether19 block below)
SOMVR_HEAD_TETHER_CM=50
SOMVR_HEAD_TETHER_BLACK_CM=90
SOMVR_HEAD_TETHER_HOLD_MS=1000
SOMVR_HEAD_TETHER_BACK_MS=300
# ---- build 19, the parry18 helper (docs/re-xr-pipeline.md 65.7): a way through a shield orc that only blocks - step or
# lean out of its red blow and it is open for 1.5 s (dodge, then counter); or shove its shield aside with the free left
# hand (a quick push into it) for a 1 s opening; a full cut in any opening breaks a raised shield. A parried orc reels
# only half a step (25 cm), so the counter-cut reaches it. Off: SOMVR_PARRY_DODGE=off / SOMVR_SHOVE=off /
# SOMVR_PARRY_REEL_CM=0.
SOMVR_PARRY_DODGE=on
SOMVR_SHOVE=on
SOMVR_PARRY_REEL_CM=25

# ---- build 19, the crowd19 helper (for build 19's file; docs/re-xr-pipeline.md 70, handoff/HANDOFF-combat.md "build
# 19: the first crowd"): the practice page's "Spawn group" (beside "Spawn an orc"; no switch) puts 4 orcs around Talion
# - an infantry and a shield in front, an infantry and a berserker beside and behind him. The crowd's pace: one orc
# winds up at a time, its blow lands at least this many ms after the last one (the next may wind up as it lands), the
# others circle and wait their turn; one grant a pass; FRONT's warnings only near the turn's end. 0 = off.
SOMVR_CROWD_PACE_MS=700

# ---- build 19, the som-b19-menu-1 helper (docs/re-xr-pipeline.md 73, handoff/HANDOFF-menus.md "build 19"): the VR
# menu's Settings tab has a second page, "Fight settings >" (no switch): the sword's, the bow's and the fight's rows -
# Sword angle, Sword weight, Blade bite, Arrows, and new: Bow string, Dodge (A), Wraith step, Stealth kill, Crowd pace,
# Counter icon (live, saved like the others; a key not in the settings file follows its switch). And a game menu opened
# with the head looking up - the Ithildin page after a look up at a glyph - gets its board up the gaze (at most this
# many deg above the level; was level: 49 deg below the gaze). Off: =0.
SOMVR_XR_MENU_PITCH_UP=45
# ---- build 19, the stealth19 helper (som-b19-stealth-1; docs/re-xr-pipeline.md 72, handoff/HANDOFF-stealth.md "build
# 19"): sneaking up for the stealth kill. The game notices Talion inside ~108 cm of an orc (root to root), crouched or
# not - its own rule, as in the flat game, whose stealth kill starts from farther out. Crouched in the back half of an
# orc that has not noticed him, his walk now eases to a stop this far from it - arm's reach for the sword and the dagger
# (the game's own stealth-kill prompt is up there) - with one soft tick; sideways and back are free, never a push.
# Standing, in front of it or an orc that noticed him: the game's own rules. 0 = off.
SOMVR_STEALTH_KILL_STANDOFF_CM=118
# som-b19-bow-1 (build 19, docs/re-xr-pipeline.md 71, handoff/HANDOFF-bow.md "build 19"): our string at rest too, its
# ends on the game's limb tips, the game's string node at rest on our string's middle (its strip along ours, no V
# through the riser); the trigger closed outside the quiver and held into it takes the arrow (the 17b session's
# misses); the quiver from above the shoulder down the back (the session's grabs reached 18-49 cm behind the head); an
# empty grab near the bow told at once; A quiet while the bow is out (every whole-fist grab pressed it).
# Off: STRING_DRAW=drawn, STRING_TIPS_CM=35 and the rest out.
SOMVR_BOW_STRING_DRAW=on
SOMVR_BOW_STRING_TIPS_CM=27
SOMVR_BOW_STRING_BACK_CM=28
SOMVR_BOW_STRING_LOW_CM=21,23
SOMVR_BOW_STRING_REST=ours
SOMVR_BOW_QUIVER_GRAB=held
SOMVR_BOW_QUIVER_CM=12,-5,-15
SOMVR_BOW_QUIVER_TO_CM=16,-15,-42
SOMVR_BOW_QUIVER_R_CM=25
SOMVR_BOW_NOARROW_CM=40
SOMVR_BOW_A=quiet
# ---- build 19, the tether19 helper (docs/re-xr-pipeline.md 69.5-69.8, handoff/HANDOFF-climb.md "build 19: the head
# tether measured"): as in Alyx, the head more than about half a metre past where Talion can stand (out over a drop,
# into a wall) dims the view; past 90 cm, or after a second there, it goes black and comes back at Talion's eyes. Only
# while the body is held back - a quick step in open ground never does it (the body catches up). These lines supersede
# build 18's SOMVR_HEAD_TETHER=off above (keep one when merging; _CM, _BLACK_CM, _HOLD_MS, _BACK_MS unchanged).
# Off: SOMVR_HEAD_TETHER=off.
SOMVR_HEAD_TETHER=on
SOMVR_HEAD_TETHER_WHEN=held
# ---- build 19, the som-b19-combat-1 helper (docs/re-xr-pipeline.md 70.7, the attack from behind): a berserker whose
# blow hit Talion answers a cut of his while he recoils (its headbutt or its bash; the game grants none). Its turn stays
# its own meanwhile (while he recoils, at most this many ms), so no other orc winds up during its answer; the answer is
# warned from the cut: the warning sound at it, an urgent pulse, out of view the red edge on its side. 0 = off.
# (SOMVR_CROWD_ANSWER_WARN=start: the warning only at the answer's start, 0.2 s later but never a false alarm.)
SOMVR_CROWD_ANSWER_MS=3000
# ---- build 19b, the som-b19b-bash-1 helper (docs/re-xr-pipeline.md 74, handoff/HANDOFF-combat.md "build 19b: the
# bodies out of the face"): FIGHT_SPACE keeps an orc's feet 90 cm away, but its strikes lean its head and shoulders far
# past them (a berserker's head came to 26-34 cm of the eyes). Now an orc whose head, neck, chest or shoulders would
# come nearer than 60 cm to the eyes is eased back by its feet (ahead of a lean it has shown before, else as it leans);
# the player and the view never move, its weapon and hands still reach the body and the guard. Off: delete the line.
SOMVR_FIGHT_BODY_CM=60
# ---- build 19b, the stealth helper som-b19b-stealth-2 (docs/re-xr-pipeline.md 72.6-72.9, handoff/HANDOFF-stealth.md
# "build 19b"): crouched behind an unaware orc, the left hand on its back (or the arm reached out at it) grabs it - not
# only on its head, which from the stand-off is out of a crouched arm's reach; then the stab is the stealth kill. The
# stand-off's stop is a steady brake (m/s^2) to rest just outside the orc's notice range, and at rest one soft tick in
# both hands: in reach. 0 = build 19's (the head only; the ease with its tick as it starts). The stand-off stays one
# number: the berserker, the shield orc and a bigger leader notice at the infantry's distance (run 20261028-054549).
SOMVR_STEALTH_KILL_GRAB_CM=45
SOMVR_STEALTH_KILL_STANDOFF_DECEL=2.5
# ---- build 20, the som-b20-climb helper (handoff/HANDOFF-climb.md "build 20", docs/re-xr-pipeline.md 78): the user's
# build 19b session hung 16 s over the cliff's top with the eyes 110 cm over it and asked for a press of A onto the
# ledge once the shoulders are over it. MANTLE: holding or hanging at a top with the eyes 25 cm
# or more over it and room on it straight ahead, a gold ring shows where he will stand (a light tick); A's press = a
# smooth glide onto it (up until the feet clear the edge, then in: one curve, ~0.4 s), then he stands. At a top without
# one (too low, no room) A = a soft double buzz, nothing moves; elsewhere A is the drop as ever. =blink: the pullover's
# quick blink instead of the glide. Off: =off (A at a top is the drop's, as build 19b).
SOMVR_CLIMB_MANTLE=glide
# ---- build 20, the som-b20-bugs helper (docs/re-xr-pipeline.md 75, handoff/HANDOFF-build20-bugs.md): the sword's draw
# and sheathe sounds come only from the player's hand. The game drew or sheathed Talion's sword by itself (its draw on
# the run at an orc while the sword stayed on the back, its sheathe out of a fight while the sword stayed in the hand)
# and played Talion's own fol_ply_cbt_swd_unsheath / _sheath (the sheathe after its twirl, fol_ply_cbt_swd_twirl):
# heard with no hand at the slot. Those posts of the game's are dropped while the slots run (SOMVR_SLOTS_GAMESOUND_NAMES
# = those three by default); ours at the hand, the orcs' and every other sound stay. Off: delete the line.
SOMVR_SLOTS_GAMESOUND=drop
# SOMVR_HINTS_KEEP unset: the game's collectible tutorial ("Enter the Wraith World (Y) to find the nearby Ithildin /
# locate the nearby Artifact"), 3-8 s after coming near one, for 12.5 s - build 19b's prompt at a climbing wall and
# the Y prompt in the meadow's fights - is dropped with the other hints (SOMVR_HINTS=off, as build 16).
# ---- build 20, the som-b20-bow helper (docs/re-xr-pipeline.md 76, handoff/HANDOFF-bow.md "build 20"): the bow's flow.
# The quiver off ("Arrows: Auto" on the VR menu's Fight page, Quiver still there): the next arrow rests on the string
# while the bow is out; the right hand to the string + the trigger draws it (squeezed on the way and held in: the same);
# none left: no arrow, three knocks. No aim assist: the arrow flies exactly along the bow's line and hits an orc only
# where that line passes through its head or body (before any wall). While drawn, a ring where that line meets an orc
# (blue: a hit) or the world (gold), at that depth in both eyes. The wrist menu closes when the bow comes out (its ray was
# the unexplained line from the right hand in the 19b session). Off: QUIVER=on / AUTO_ARROW=off, ASSIST_DEG=5 with
# AIM=assist, AIM_RING=off, SOMVR_XR_VRMENU_BOW=keep.
SOMVR_BOW_QUIVER=off
SOMVR_BOW_AUTO_ARROW=on
SOMVR_BOW_ASSIST_DEG=0
SOMVR_BOW_AIM=exact
SOMVR_BOW_AIM_RING=on
SOMVR_XR_VRMENU_BOW=close

# ---- build 20, som-b20-menu (docs/re-xr-pipeline.md 80): menus that hold still and a pointer that locks on. The wrist
# panel held steady over a shaking hand (it stays put while the hand's panel pose stays within 1.5 cm and 3 deg, follows
# by the excess beyond: a real move at once; code default off = build 19's panel on the hand); the ray locks on the
# panel's parts - a locked part holds through a 1-deg shake, a point between parts takes the nearest within 2 deg, the
# press goes to the locked part, which is outlined (code default off); the pointer's point held through a 0.6-deg shake
# on every VR menu - the panel and the game's front board (code default off). A fingertip's touch is unchanged.
SOMVR_XR_PANEL_STEADY=on
SOMVR_XR_PTR_SNAP=on
SOMVR_XR_PTR_HOLD=on
# the panel's ray only on it or aimed within half its size of it (code default always = build 19's: a line out of the
# right hand whenever the panel is open, wherever the hand points)
SOMVR_XR_VM_RAY=near

# ---- build 20, the som-b20-finish helper (docs/re-xr-pipeline.md 77, handoff/HANDOFF-verbs.md "build 20"): the end of an
# interrogation. The left hand's grab holds the view only while the game holds Talion: his ticks the player's own
# (LOCO) for SOMVR_BM_GRAB_FREE_S and the hold lets go (the user's build 19b session: the view stuck on the held point
# for 30 s while the stick walked Talion away; 0 = as build 19b). The sword's stab into the interrogated orc is its
# Eliminate (the game's finisher is the only death there; game = only the Touch's B, as build 19b). The GAIN INTEL menu
# after Interrogate is left by the pad's Back after SOMVR_VERBS_INTEL_BACK_S: the game goes back to the held orc and its
# choices, not on to its finisher (0 = the menu as the game has it; the Touch's B is its Back any time). The far
# practice orc 10 m out (was 18). (SOMVR_BM_RETURN_CM stays 0: the game's held sync puts Talion back against the walk.)
SOMVR_BM_GRAB_FREE_S=1.0
SOMVR_VERBS_ASK_KILL=blade
# SOMVR_VERBS_INTEL_BACK_S=8 (build 20; build 27 sets it in the som-b27-nemesis2 block)
SOMVR_PRACTICE_FAR_CM=1000
# ---- build 20, the som-b20-sword helper (docs/re-xr-pipeline.md 79, handoff/HANDOFF-combat.md "build 20: real swings,
# the blade at walls"): a cut needs a real swing, as in Blade & Sorcery - the blade's tip moving one way (a stroke that
# reaches 50 cm) and the blade where it meets the orc moving at 12 m/s or more, the edge leading; its damage by that
# speed (60 % at 12 m/s, full from 20). A flail or wiggle (short strokes, a contact while the blade is still slow) is at
# most a light hit; a tracking jump (over 60 m/s) is no swing. The drawn blade stays at walls, rock and the ground: it
# turns about the grip and rides along the surface while the hand stays where the controller is; its meeting clanks
# (pulses, the game's surface-impact sound, sparks where it meets). Orcs are no surface. Off: SOMVR_COMBAT_SWING=off /
# SOMVR_HANDS_SURFACE_BLADE=push (build 13's: the blade pushes the hand back up to 25 cm, then goes in).
SOMVR_COMBAT_SWING=stroke
SOMVR_HANDS_SURFACE_BLADE=pivot
# ---- build 21, som-b21-ui (docs/re-xr-pipeline.md 82, handoff/HANDOFF-menus.md "build 21"): the bow's sight smaller,
# thinner and not gold - a soft-white ring with a dot and a faint dark edge (wraith-blue on an orc), 1.5 deg across
# (SOMVR_BOW_AIM_RING_DEG's new default; where it sits unchanged); the VR menu's Test tab (the build's
# mod/somvr/assets/what-to-test.txt, its pages; the X box leaves the panel's pages, the arrival card keeps it); a bug
# mark's voice note until the player stops talking (2 s quiet; 5 s when nothing is said; 30 s at most; a new mark ends
# the last note at once - boot_check.sh + voice_rec.py). Off: SOMVR_BOW_AIM_LOOK=ring20 (3 deg, build 20's gold),
# SOMVR_XR_VM_TEST=off, SOMVR_MARK_VOICE=fixed (SOMVR_MARK_VOICE_S above).
SOMVR_BOW_AIM_LOOK=sight
SOMVR_XR_VM_TEST=on
SOMVR_MARK_VOICE=talk

# ---- build 21, the som-b21-combat helper (docs/re-xr-pipeline.md 85; handoff/HANDOFF-combat.md "build 21") ----
# The blocking bug (85.2): the shield orc's endless Block_Into/Loop/OutOF came from our own REACT notify - the flat game
# never sends a Defender that "incoming attack" (it has no AIBlockTable), and its counter-block then never ends while
# Talion stands in front. 0 = no notify for a Defender: its shield still blocks frontal cuts by the game's own rule.
SOMVR_COMBAT_REACT_DEFENDER=0
# The grab cue (85.1): the open left hand in grab reach of an orc the game would grab now - a faint wraith-blue glow at
# its collar and one light tick in the left hand. No prompt.
SOMVR_VERBS_CUE=on
# Shadow Strike's sword (85.3): the strike is a sword kill - the sword comes to the main hand as it starts (the bow to
# its slot) and stays there after.
SOMVR_STRIKE_SWORD=hand

# ---- som-b21-render (build 21's render round, re-xr-pipeline.md 86, handoff/HANDOFF-render.md) ----
# The flat screen's effects out of the eyes (the user's build 20c mark 12: "a lens flare ... doesn't really work in VR"):
# the lens flares' draw, the sun's screen-space shafts (their streaks point another way in each eye), the game's own
# vignette and box blur (a screen-fixed visor), the drops on the lens. The sun, the bloom and the shadows stay; motion
# blur and DoF were off already (SOMVR_COMFORT=1). Off: SOMVR_FLATFX=game (or a comma list of the parts to turn off).
SOMVR_FLATFX=all
# ---- build 21, the som-b21-view helper (docs/re-xr-pipeline.md 87, handoff/HANDOFF-hud.md "build 21"): popups where you
# look, nothing smoky in the face. The prompt band's tiles (the XP gains, the hints, the place banners, the button
# prompts) each their own quad, shown while the game's HUD has something in them: placed in front of the gaze as it comes
# up (13 deg under it, at the band's distance and size), still in the room while it shows, eased (0.35 s) to the new front
# when the head turns more than 40 deg away; the next one placed afresh (build 20c: one band placed once a session).
SOMVR_XR_POPUPS=gaze

# ---- som-b21-kill (build 21: the stealth kill as the player's own thrust, the blade stuck, the gash; docs/re-xr-pipeline.md 84)
# Behind an unaware orc the kill is a deliberate thrust: the point leading (within 30 deg of the blade), driven at least
# 15 cm into its body (its skeleton's spine, chest or neck; not combat's hit capsule) at 1.5 m/s or more along the blade,
# into its back, neck or side - or a full-speed cut (the stroke's heavy tier) to its neck; held from behind by the left
# hand, any point-first stab 10 cm in. Anything else in its body (a touch, a glance, a wiggle, a slow push) does no damage
# and alerts it 0.3 s later unless the kill comes first. Off: =off (build 20c's: a hit or a stab on the first contact).
# Tunables: SOMVR_STEALTH_KILL_THRUST_MPS (1.5), _THRUST_DEG (30), _DEPTH_CM (15), _GRAB_DEPTH_CM (10), _GRACE_MS (300).
SOMVR_STEALTH_KILL_THRUST=on
# The blade stays in the wound: pinned along its way in, the hand slides it in and out, sideways it lags the hand and
# tears free 25 cm off (SOMVR_STEALTH_KILL_STICK_TEAR_CM); it comes out drawn back past the wound or as the body falls
# off it; a heavy thunk going in, a rumble while it slides. Off: =off.
SOMVR_STEALTH_KILL_STICK=on
# The game's blood (SOMVR_COMBAT_HITFX's stab FX) at the wound as the blade goes in and as it comes out. Off: =off.
SOMVR_STEALTH_KILL_BLOOD=on
# An approach begun crouched keeps the stand-off (118 cm) this long after the crouch ends - drawing the sword lets the
# stealth crouch go, and the walk went on into the orc's notice range (build 20c's session, mark 17). 0 = build 20c.
SOMVR_STEALTH_KILL_STANDOFF_KEEP_S=3

# som-b21-climb (build 21, re-xr-pipeline.md 83): the descent's hold timer (a white ring in the landing ring empties over
# the 0.3 s hold, flashes + a tick = armed; let go before = nothing), never stuck (a stick held at A's press is no
# cancel, the plain fall offered when there is no blink landing, A at a top without a mantle = the way down, a fling
# never carries him past the wall's reach), the round lip's real top (the wall by the meadow's ladder). Off: =off each.
SOMVR_CLIMB_DESCENT_TIMER=on
SOMVR_CLIMB_UNSTUCK=on
SOMVR_CLIMB_ROUND_LIP=on
# SOMVR_CLIMB_DOWN_OVER (the grip over an edge = the glide down to hang there): off - unit-tested only; its one real try
# (run 222900, the meadow bank) met a face sloping out under the lip; the wall check that now refuses that is untried
# SOMVR_CLIMB_DOWN_OVER=off (build 21; build 22 sets it in the som-b22-fixes block)

# the coordinator (build 21): the drop's hold timer runs 0.6 s, not 0.3 s - the user asked for a circle that "slowly
# depletes" (their 20c holds lasted 1.2-1.8 s); 0.6 s reads as a sweep and still drops quickly
SOMVR_CLIMB_DESCENT_MARK_HOLD_MS=600
# ---- build 22, som-b22-screens (docs/re-xr-pipeline.md 90, handoff/HANDOFF-drill.md "build 22"): death and the game's screens
# The death in first person: the view stays where Talion fell, the world greys out (no game camera: the killer's taunt
# plays in the world, his name and line on the HUD); the Nemesis screens after it (the game's pause) on the theatre's
# screen; B on the board = the respawn back through the fade; a death without those screens comes back by a slow blink
# (out 0.35 s, black 0.6 s, in 0.6 s). Off: =game (build 21: the game's death camera in the window).
SOMVR_BM_DEATH=first
# The laser and the fingertip pick on the Nemesis screens (Sauron's Army, the death's board): the captain under the
# point is selected as a mouse's hover would (the hierarchy's KBM pick, its pad check answered for the pointer) and the
# press opens his card (the game's Mouse1 command, which that screen alone needs). Off: =off (the press only moved the
# cursor there).
SOMVR_POINTER_MOUSE1=nemesis
# The game's menu board (the pause menu and its pages - Weapons & Runes, Upgrades, Sauron's Army -, the map, the main
# menu) 0.86 m wide at 0.6 m (71 deg, was 0.72 m: 62 deg): an 18-pixel line 0.67 deg = 13.4 Quest 2 pixels (was 11.6),
# the rune and skill descriptions readable at a glance; the fingertip still reaches every corner. DIST,WIDTH,DROP (m).
SOMVR_XR_MENU_QUAD=0.6,0.86,0.10
# som-b22-beasts (build 22, re-xr-pipeline.md 92): caragors, ghuls and graugs met by the blade as their bone chain's
# capsules (a caragor's head and snout, a graug's legs; not an orc's upright one), THREAT's glow from a caragor's head,
# DEFENCE judging a caragor's bite on its line (it lands at range) and a graug's fists by contact, a beast's takedown
# held through its struggle (the view never carried, no blink), the practice page's Caragor / Ghul / Graug, the BEASTS
# lines. Off: SOMVR_BEASTS=0 (build 21's: every enemy an orc).
SOMVR_BEASTS=1
# ---- som-b22-captain (docs/re-xr-pipeline.md 88, handoff/HANDOFF-captain.md): a Nemesis captain in VR ----
# The captain module (the code default on): the practice page's Captain button, the captain's introduction in the world,
# his traits' rules for our finishers. off = build 21 (no button; every presentation in the window; forceKill on all).
SOMVR_CAPTAIN=on
# A captain's presentation that starts with him within 15 m and 60 deg of the view plays in the world (the player's own
# view, the presentation camera ignored); else the window as before. window = build 21. Geometry: SOMVR_CAPTAIN_INTRO_GEOM.
SOMVR_CAPTAIN_INTRO=world
SOMVR_CAPTAIN_INTRO_GEOM=1500,60
# His traits rule our execution and stealth kill (immune: no finisher; vulnerable: the kill; else the record's own damage,
# no forceKill), and =stagger's health write / SOMVR_COMBAT_SLIVER leave captains alone. off = build 21 (forceKill on all).
SOMVR_CAPTAIN_RULES=on
# The Captain button brings the save's next captain this far ahead (cm; 400..2500).
SOMVR_PRACTICE_CAPTAIN_CM=1000
# While a practice captain is out, the practice's min health is lifted: he can kill Talion and be promoted (the save's
# own captain, as anywhere). off = Talion cannot die in the practice area even to a captain.
SOMVR_PRACTICE_CAPTAIN_STAKES=on
# Our finisher (the execution, the stealth kill, the ground finisher) on a captain who is not vulnerable to it takes at
# most this much of his max health and leaves him alive (the record's own damage kills anyone: run 024657). 5..95.
SOMVR_CAPTAIN_FINISHER_PCT=33
# ---- som-b22-fire (build 22's fire round, docs/re-xr-pipeline.md 94, handoff/HANDOFF-fire.md): nothing switched on ----
# The fire's and the wraith sky's per-eye difference is GPU-side (the CPU particles' vertices are the same in both eyes).
# Each eye its own current-frame images (SOMVR_CURFRAME=eye) is half of the wraith sky's cause (with the game thread kept
# from running ahead the eyes' sky is the same) and does not change the fire; alone it is not shown better for the
# player, so the game's stays (code default game).
# Build 23 (som-b23-render, re-xr-pipeline.md 96): both were the shaders' clock k_fTime in eye 1 - SOMVR_KTIME=frame (the
# som-b23-render block) makes the fire and the wraith sky the same in both eyes without SOMVR_CURFRAME; it stays off.
# SOMVR_CURFRAME=eye
# ---- som-b22-story (build 22: a story mission played straight through; docs/re-xr-pipeline.md 89,
# handoff/HANDOFF-story.md "build 22")
# The game's subtitle line (the story's spoken lines in the world, e.g. at the Sea Fort) was cut in two by the popups'
# tiles: its right part in the button prompts' popup, the rest in the world HUD quad at 0.42 deg. Its own popup now,
# placed under the gaze like the others, at 80 % of their scale (a line 0.9 deg); the prompts' tile starts below it.
# Off: =off. Tunables SOMVR_XR_SUBTITLES_RECT (400,820,1120,120), _SCALE (80 %).
SOMVR_XR_SUBTITLES=on
# The stealth brand's prompt ("Stealth Brand", B on the game's stealth key) was dropped as "no VR control sends it"; the
# open left hand on the orc's head and the left trigger send it: kept, shown with the left trigger's glyph. Off: =off.
SOMVR_VERBS_BRAND_PROMPT=on

# som-b22-move (build 22, re-xr-pipeline.md 91): the jump. A on foot when nothing else claims it (the strike's mark,
# the dodge in a fight, a climb, the descent's edge while standing) = the jump: 60 cm up at the game's gravity, the
# stick's speed carried 1:1 in the air, no animation in the view, the landing braked (no dip); a grip in the air = the
# climb catches it. Off: =off.
SOMVR_JUMP=on
# SOMVR_VAULT (a ring past a 45-120 cm obstacle, A = over it): off - unit-tested only; the practice meadow has no
# waist-high wall to prove it on (run 025133's grid: rocks and slopes 45-62 cm; the slopes it took for tops are refused
# since, unproven in the game)
# SOMVR_VAULT=off (build 23; build 24 sets it in the som-b24-move block)

# som-b22-fixes (build 22, re-xr-pipeline.md 93): an overhang's lip held from below with room on its top shows the
# mantle's ring and A = the glide out round the lip and up onto it (nothing moves before the press); the blade stops on
# the open ground (a ray straight down at the tip; off: not needed - see its line); after a finisher his body is put under the
# held view (one Teleport) instead of the re-seat's blink; a blade the walk carried into an unaware orc's back is no
# touch (only the hand's own motion is). Off: =off each (SOMVR_BM_RETURN_CM=0: the blink, as build 21).
SOMVR_CLIMB_MANTLE_OVERHANG=on
# SOMVR_HANDS_SURFACE_GROUND (a ray straight down at the blade's tip): off - the blade's own ray already meets the
# meadow's open ground ('Grass', the hands stop on it); the headless "blade in the grass" never had its tip in the ground
SOMVR_HANDS_SURFACE_GROUND=off
SOMVR_BM_RETURN_CM=150
SOMVR_BM_RETURN_TP=on
SOMVR_STEALTH_KILL_CARRIED=on
# down over an edge (build 21's, 83.4): proven on three real walls (the meadow ladder's wall top, the bank, mark 5's
# platform: the glide and the hold, hand over hand down) once the glides' blocked check scales with the frame: on.
SOMVR_CLIMB_DOWN_OVER=on

# ---- som-b23-polish (build 23, re-xr-pipeline.md 95): the captain's card, the grab cue on captains, the launcher ----
# The captain's introduction card comes up whole in the subtitles' popup at the gaze: code defaults (no switch) -
# SOMVR_XR_PROMPTS_RECTS 640,10,640,110|440,600,1040,155|30,390,290,190;1120,940,800,140 and SOMVR_XR_SUBTITLES_RECT
# 400,755,1120,185 (were 1040,180 / 1120,860,800,220 and 400,820,1120,120: the card in three pieces).
# The grab cue on a Nemesis captain asks the game how his grab would end ('PC_Grab_Into_F' or '_Resistant'): the glow
# only where it holds. Off: =off (build 22: the cue also on a captain who throws the grab off).
SOMVR_VERBS_CUE_CAPTAIN=on
# som-b23-render (re-xr-pipeline.md 96): the shaders' clock k_fTime the same in both eyes - RenderScene's late pass left
# k_fRealTime in it for eye 1's whole pass, so the fire's flame, the wraith look's sky clouds and every time-animated
# material moved differently in each eye. frame: eye 1's pass gets eye 0's k_fTime back (no frame cost; proven headless:
# the campfire and the wraith vision identical in eyesame, the vision's sky the same in both eyes). game: as the game does.
SOMVR_KTIME=frame
# som-b23-brand (build 23, docs/re-xr-pipeline.md 97): the brand by the hand. With a charged hit streak the open left
# hand on an orc's head + the left trigger = the game's combat brand (its chord B + A, where the game offers PC_InstaHOG;
# SOMVR_VERBS_BRAND_COMBAT=any, the code default); where the game offers the stealth brand the trigger's press is the
# pad's tap (the stealth brand itself is not made yet: 97.2). SOMVR_VAULT stays off (no 45-120 cm obstacle found: 97.4).
SOMVR_VERBS_BRAND=on
# som-b24-brand (build 24, docs/re-xr-pipeline.md 98): the stealth brand by the hand, proven (the game's own
# PC_Bip_StealthBrand_B from the left trigger with the open hand on an unaware archer's head). Why it was refused: from the
# Sea Fort's video until "Ability Unlocked: Brand" is closed the game's input mode has every combat command off (the
# game's node log: "Command 'CombatPrimary03' is not enabled" for every node) - every earlier press fell in that intro,
# as a pad's would. Here: the story missions' own tutorial texts (GP_*) pass with SOMVR_HINTS=off (the archers' lesson
# shows where the game shows it), and in UI texts B's icon is the left trigger's (the brand, the drain and the stun are
# the left trigger in VR: the popup's "Stealth Brand: Hold RT + tap LT").
# SOMVR_HINTS_KEEP_TUT=GP_ (build 25; build 26 sets it in the som-b27-soak block)
# SOMVR_TEXT_BUTTONS=122:119,120:124 (build 24; build 25 sets it in the som-b25-missions block)
# ---- som-b24-render (build 24, docs/re-xr-pipeline.md 100, handoff/HANDOFF-render.md "build 24"): the frozen world when
# Talion is hurt. The cause: at low health the game's damage overlay (COverlayFX) sets up one view per eye with that eye's
# camera; H3 matched views by the camera's hash only, so with both eyes one camera (`fx eyesame 1`) the overlay in eye 0's
# pass took eye 1's queued view - "the tag says eyes 0x2", the last stereo frame for minutes. SOMVR_EYE_MATCH=pass: a view
# inside an open eye pass with its camera is that eye's (hash = build 23's). SOMVR_XR_STALE=6: the layer shows the last
# stereo frame again for 6 presents at most, then the loading space through the fade until 3 stereo frames came back
# (off = build 23's). SOMVR_FLATFX=all (above) now also takes the game's full-screen overlays (blood drops at the screen's
# bottom and a red wash in each eye at low health) out of the eyes - `overlay`; Talion's hurt stays SOMVR_HURT's red edge
# flash, and SOMVR_HURT_LOW=0.25 keeps a faint steady red on both edges while his health is under a quarter.
SOMVR_EYE_MATCH=pass
SOMVR_XR_STALE=6
SOMVR_HURT_LOW=0.25
# som-b24-captain (build 24, docs/re-xr-pipeline.md 99): a captain's fight for arms. A committed cut or stab on a Nemesis
# captain takes the game's own damage for it (his defence, buffs, min health, the death and its credit stay the game's)
# times SOMVR_CAPTAIN_CUT_X x the cut's speed factor (0.6 at 12 m/s .. 1 from 20 m/s), never less than the game's own; a
# light hit (a tap, the flat, a slow contact) the game's own. Off: SOMVR_CAPTAIN_DAMAGE=off (build 23: the game's own).
SOMVR_CAPTAIN_DAMAGE=cut
SOMVR_CAPTAIN_CUT_X=2.0
# A stealth thrust into a captain immune to stealth kills: hit = the ordinary hit (build 23). turn (built, NOT proven
# headless - the scripted thrust never reached a captain's back in 4 tries: re-xr-pipeline.md 99.3) = turned at his
# back: the clank's sound and sparks, a knock in the hand, no wound, his alert. A captain who survives a stealth kill
# (resistant: a third of his health) keeps no blade (no switch).
# SOMVR_CAPTAIN_STEALTH_IMMUNE=hit (build 24; build 25 sets it in the som-b25-nemesis block)

# som-b24-move (build 24, docs/re-xr-pipeline.md 101): the vault on real obstacles. Walking at a 45-120 cm wall, stub
# or block (the ruins' low walls), a gold ring shows past it or on its top and the right hand ticks; A = over it or up
# onto it in under a second, the view level, landing on the ring (proven at four real obstacles: over a 75 cm stub and
# a 62 cm wall, onto 59 and 89 cm blocks). Never past the ring: on a far floor lower than planned the rest of the fall
# is straight down onto it (SOMVR_VAULT_RING_STOP). Off: SOMVR_VAULT=off (A is the jump there as before).
SOMVR_VAULT=on
SOMVR_VAULT_RING_STOP=on

# som-b25-missions (build 25, re-xr-pipeline.md 103): a mission's failed screen after a death and a Nemesis result screen answered by A/B
SOMVR_USE_DEATH=on
SOMVR_USE_SKIP=on
# the branded orcs commanded by the left hand raised over the head + the left trigger (CombatTertiary03 128: "Activate
# your branded archers" at the Sea Fort had no VR control); its icon in the lesson's text = the left trigger's
SOMVR_VERBS_RALLY=on
# SOMVR_TEXT_BUTTONS=122:119,120:124,128:124 (build 25; build 26 sets it in the som-b26-story block)
# som-b25-nemesis (build 25: a captain of the world met in VR, the immune captain's turned stealth thrust; docs/re-xr-pipeline.md 104)
SOMVR_CAPTAIN_WORLD=on
SOMVR_CAPTAIN_WORLD_INTRO_GEOM=6000,90
SOMVR_CAPTAIN_STEALTH_IMMUNE=turn
# som-b25-above (build 25, re-xr-pipeline.md 102; handoff/HANDOFF-stealth.md "build 25"): the drop kill by the hands.
# Crouched on a ledge or wall top over an orc the game would drop-kill (its own selection asked; no offer, no kill), a
# faint blue glow at his collar; the sword drawn, a fast downward plunge of the sword hand, point first, aimed at him =
# the game's own drop kill ('PC_InstaKill_FromAbove_B/F' -> 'PC_Bip_JumpDown_IK_FromAbove_*', started on that orc as
# SOMVR_FINISH starts an execution: the pad's X found no target below). The view never rides the drop: held at the
# plunge, black as the game's kill starts (0.12 s), put on the ground 70 cm short of the orc at Talion's standing eye
# height once he has landed, back in (0.2 s), held to the kill's end (the kill plays in place under it); a refused
# plunge shows nothing. Off: =off (the pad's X only, as build 24). Tunables (defaults): SOMVR_ABOVE_DROP=on,
# SOMVR_ABOVE_START=game|press, SOMVR_ABOVE_PLUNGE=2.0,1.4,40,40 (m/s, m/s down, the point's deg, the aim's deg),
# SOMVR_ABOVE_FADE_MS=120,200, SOMVR_ABOVE_CUE_LEVEL=0.55 (0 = no glow), SOMVR_ABOVE_BELOW_CM=120, _FAR_CM=600.
# SOMVR_ABOVE_BRAND (the open left hand aimed down at his head + the left trigger = 'PC_Brand_FromAbove_*'): off - the
# game never offered it on the test save (brand locked outside its mission); unit-tested only.
SOMVR_ABOVE=on

# som-b26-ride (build 26, docs/re-xr-pipeline.md 105): Big Game's caragor in VR - its leap blocked by the sword held across
# its line = the game's counter (it lies stunned), the left hand reached out at it and closed (or B) at the game's offer =
# the mount (the view held, no game-driven move), the domination's "Hold tight!" = the left hand kept closed; riding: A
# leap, right trigger bite, B off. Off = build 25 (the leap only blocked, no mount control).
SOMVR_RIDE=on
# Seat mode (first person on the saddle: the beast's root + the rider's eyes, the gait filtered, no pitch or roll, the yaw
# car-style at most 150 deg/s, getting on/off blinked) is proven on the selftest only - no headless boot reached a mount:
# off = a mount is the window (build 25). On after a headless ride's proof.
# SOMVR_RIDE_SEAT=off (build 26; build 27 sets it in the som-b27-ride2 block)
# som-b26-story (build 26, re-xr-pipeline.md 106): a Domination's "(B) Dismiss" by the Touch's B, its "(Y) Command" by the Touch's Y; the grab's icon in UI texts = LB (the left grip)
SOMVR_VERBS_DISMISS=on
SOMVR_VERBS_COMMAND=on
# SOMVR_TEXT_BUTTONS=122:119,120:124,128:124,123:122 (build 26; build 27 sets it in the som-b27-story2 block)
# som-b27-soak (build 27, re-xr-pipeline.md 107.6): the game's first-time struggle tutorial ('PC_StruggleTutorial', a
# Berserker's death struggle) pauses the game until its button (A); SOMVR_HINTS=off dropped its text: 154 s on the knees
# with nothing shown (soak 2). Kept now, the GP_ missions' tutorials as before.
# SOMVR_HINTS_KEEP_TUT=GP_,PC_Struggle (build 27; the coordinator sets it in its build 27 block below)
# som-b27-ride2 (build 27, docs/re-xr-pipeline.md 109): the caragor's domination is won by holding on - the left hand that
# grabbed it kept closed (or B held) 1.5 s through "Hold tight!" (SOMVR_RIDE_DOM_HOLD_MS, code default 1500); then Seat mode:
# first person on the saddle (no pitch/roll of the gait, the yaw car-style), the left stick steering in the beast's frame,
# A the leap, the right trigger the bite, B off - proven in headless rides (boots 20261030-035009..064036).
SOMVR_RIDE_SEAT=on
# som-b27-story2 (build 27, re-xr-pipeline.md 110): the HUD's "No Warchief Selected - Hold [>]" = the pad's START held (Sauron's Army's warchief board); in VR the right stick's click held (a click = the map), the HUD's [>] with that click's icon (14:127)
SOMVR_ARMY=on
SOMVR_TEXT_BUTTONS=122:119,120:124,128:124,123:122,14:127
# som-b27-combat (build 27, docs/re-xr-pipeline.md 108; handoff/HANDOFF-combat.md "build 27"): the vault over an orc.
# The wraith step (the right stick pushed forward and held) aimed with the head at an orc within 3.5 m = the gold ring
# 120 cm behind it, on the line from Talion through it (red: a wall or a fence at its back, a ledge, another orc there);
# let go = the same quick blink over it, the facing kept (turn yourself to cut its back: a shield orc's open side).
# Off: SOMVR_WRAITH_STEP_VAULT_CM=0 (the head on an orc = the red ring, as build 26).
SOMVR_WRAITH_STEP_VAULT_CM=350
# The orc vaulted over is open for 2 s (as a dodged blow opens it): turn and cut - a full cut then goes through its
# block and smashes a shield it has turned back (the riposte). Off: SOMVR_PARRY_VAULT_MS=0.
SOMVR_PARRY_VAULT_MS=2000
# A crowd's fairness: an orc given its turn while in view that is out of view before its blow starts (it walked round
# you, you turned, you vaulted it) now gets the warning's cue then - the sound at it, a tick on its side, the edge glow
# held until its blow lands - instead of only the late cue at the swing. Off: SOMVR_FRONT_TURN_CUE=off.
SOMVR_FRONT_TURN_CUE=on
# The death struggle (the last chance when an orc is about to kill you, Talion on his knees; the game's red ring and a
# cursor on the HUD): move a hand toward the ring - the hand steers the cursor (20 cm = full speed; the left stick
# works too, no longer turned) - and stab (a hard thrust of either hand) while the cursor is in the ring = the game's
# win (Talion throws him off and gets up); a stab outside the ring does nothing. An urgent double buzz when it starts.
# Only Talion's last chance (a domination's struggle is left alone). Off: SOMVR_STRUGGLE=off (as build 26: no answer).
SOMVR_STRUGGLE=thrust
# som-b27-hla (build 27, docs/re-xr-pipeline.md 112, handoff/HANDOFF-hla.md): the first ten minutes held to HL:A. The
# VR menu's Controls page lists every gesture this build has, in groups, paged (Prev / Next), each line only where its
# feature runs; the arrival card shows the first steps and where the rest is; Settings: Walk toward (Head / Hand =
# SOMVR_MOVE live, saved as MOVE; SOMVR_MOVE stays head) and Main hand renamed Pointer hand (what it does). No switch
# for those. The card's "Close: ... or A" no longer jumps: A while the menu or the card is up, or within 0.4 s of its
# closing, is theirs (build 26: that A started a jump). Off: SOMVR_JUMP_MENU_S=0.
SOMVR_JUMP_MENU_S=0.4
# som-b27-world (build 27, docs/re-xr-pipeline.md 111): the open world's own systems in VR. The map (the right stick's click)
# took only the pad's buttons - the laser and the fingertip did nothing on it: now a click on the map brings that place to the
# cross, a click on the cross sets the waypoint (A), a click on a forge tower's popup = Fast Travel / Advance Time, a held
# press steers the map (the game's own pan; nothing moves the view). The map's waypoint was the game's flat icon at the HUD's
# edge: now our world marker (as the objective's), before the nearest objective. Off: =off each (build 26).
SOMVR_MAP_POINT=on
SOMVR_OBJECTIVE_WAYPOINT=on
# som-b27-abilities (build 27, docs/re-xr-pipeline.md 114): the abilities Talion gains by the VR player's hands, each on
# the game's own offer (the skill owned, the streak, the target): the wraith flash = the right trigger held (the wraith
# charge) + the open left hand thrust out at an orc (the game's 'PC_WraithAoE' attack started); the ground finisher = the
# sword's stab down into a downed orc (the game's own ground record, Combat_DealHit forceKill); the cues a blue glow at
# the left palm / on the downed orc. Off: SOMVR_ABIL=off.
SOMVR_ABIL=on
# som-b27-perf (build 27, docs/re-xr-pipeline.md 115; handoff/HANDOFF-perf.md): what a stereo frame costs, logged every
# 10 s in the user's session - the render thread's frame work (the limit: 10-13 ms headless, about half per eye), the game
# thread's busy time, our H4 work, the GPU per eye and ours (PERF / `xr: perf` lines): the real 90 Hz numbers. Off:
# SOMVR_PERF=off, SOMVR_XR_PERF=off. The hands' vertices in host-cached memory (code default too): the present thread's
# CPU for our hands 1.85 -> 0.21 ms a frame (SOMVR_XR_HANDS_MEM=wc = the old). SOMVR_SHADOW_SHARE is not set: off (eye 1
# with eye 0's sun cascades failed its check, 115.5).
SOMVR_PERF=on
SOMVR_XR_PERF=on
SOMVR_XR_HANDS_MEM=cached
# som-b27-story3 (build 27b, re-xr-pipeline.md 113): a presentation while the left hand holds (Lithariel carried, an orc
# held) opened no window, so "Mission Failed! (A) Retry" took A only after the grip opened; now it answers as in the window
SOMVR_USE_GRAB=on
# the coordinator (build 27): the "Ability Unlocked: Caragor Hunter" card pauses the game for its tutorial
# (tut_WargRidingUnlocked) - its text dropped by SOMVR_HINTS=off (som-b27-story3's notice, re-xr-pipeline.md 113); a
# pausing tutorial must show, so it passes like the missions' lessons and the struggle's
# SOMVR_HINTS_KEEP_TUT=GP_,PC_Struggle,tut_WargRidingUnlocked (build 27; build 27c sets it in the som-b27-story4 block: SOMVR_HINTS_PAUSING passes every pausing tutorial)
# som-b27-climb3 (build 27, docs/re-xr-pipeline.md 117, handoff/HANDOFF-climb.md): climbing the real world by hand, end
# to end. A forge tower climbed from its foot: a narrow ledge under the platform's overhanging lip was reached first,
# then a hand took the lip - the climb kept the ledge's top (no room on it), so the platform's ring never came, A only
# buzzed and the push held Talion under the edge. Now a hold that is an edge with its own top 30+ cm over the top
# reached forgets that ledge: the platform's ring shows, A = onto the top. Off: SOMVR_CLIMB_RETOP_EDGE=off (build 26).
SOMVR_CLIMB_RETOP_EDGE=on
# The ring a player sees is what A does: the ring comes from a search up to 0.5 s (or 5 cm of movement) old and A
# searched again at the press - at the Sea Fort camp's coping (an overhang's ring, the eyes 52 cm under it) a press
# after Talion had settled a few cm found no overhang and was the drop's timer. Now A while the ring shows takes that
# ring (its landing and its kind, the curve from where he is; the glide's own block test kept). Off:
# SOMVR_CLIMB_MANTLE_KEEP=off (build 26: A searches again).
SOMVR_CLIMB_MANTLE_KEEP=on
# SOMVR_CLIMB_FLING_REACH_HOLD (a fling at a corner: unstuck's reach test also toward the hold let go): off - unit-tested
# only (test_climb test_b27: rose 7 cm off, 215 cm on); the one real case (the forge tower's corner) was a 0 cm release.

# som-b27-perf2 (build 27b, re-xr-pipeline.md 119): the headset at 80 Hz for the session - XR_FB_display_refresh_rate (WiVRn
# has it; its own config untouched): the render thread's 10-13 ms a stereo frame holds 12.5 ms where 90 Hz's 11.1 drops
# frames (judder). The VR menu's Settings page: Refresh rate 72 / 80 / 90 / 120 Hz, live, saved. SOMVR_XR_REFRESH=0: the
# runtime's own rate (nothing asked); off: the extension not enabled (build 26).
SOMVR_XR_REFRESH=80
# The VR graphics preset (re-xr-pipeline.md 119.4): the session's own render.cfg (scripts/som-vr-headset.sh ->
# boot_check --render-set; the user's own game settings and the install untouched): vegetation Very High (Ultra 4 -> 3),
# mesh High (3 -> 2), shadows High (3 -> 2), lighting Medium (2 -> 1). The render thread (the limit) in the meadow, the
# crowd of 8 and by the fire, headless p50: 11.7 / 12.9 / 13.6 -> 8.7 / 9.3 / 9.1 ms (p95 12.7-14.3 -> 9.2-9.9). Remove the
# line for the game's own detection (Ultra).
SOMVR_RENDER_SET=VegetationQuality:3,MeshQuality:2,ShadowQuality:2,LightingQuality:1
# som-b27-abilities2 (build 27c, docs/re-xr-pipeline.md 118): two abilities the save owns that had no VR control, each on
# the game's own offer. The ignite shot: with an arrow drawn, press B - its tip glows blue; let go and the arrow sets the
# orc it hits ablaze in wraith fire (the game's own ignite; B again or letting the string down puts it out). The whistle:
# crouched and unseen, hold an empty hand at your mouth for a moment - the game's whistle lures the nearest orc to you.
# Off: =off each. The dagger's quick throw (the dagger from the left hip, thrown overhand, let go) is built but off: the
# game never offered its quick throw headless (118.3) - on only once that is found.
SOMVR_ABIL_IGNITE=on
SOMVR_ABIL_WHISTLE=on
SOMVR_ABIL_THROW=off
# som-b27-story4 (build 27c, re-xr-pipeline.md 120): no hidden pause - a tutorial the game pauses for (its record's
# page field set: the test of the game's own pausing-tutorial delegate) passes SOMVR_HINTS=off, whatever its name
# (the struggle's, "Ability Unlocked" cards); the missions' lessons pass by their GP_ names; combat hints stay dropped
SOMVR_HINTS_PAUSING=on
SOMVR_HINTS_KEEP_TUT=GP_
# som-b27-story4: while a window is open (a presentation, a failed or result screen) a press is the screen's, not the beast's - B there
# skips or closes it and no longer gets Talion off, A's Retry no longer leaps (boots 163325, 195017); a held run goes on
SOMVR_RIDE_WIN_REST=on

# som-b27-nemesis2 (build 27, docs/re-xr-pipeline.md 116): a beaten captain's Last Words answered as an interrogation (the left
# trigger = Interrogate, B and the blade = Eliminate). Off: =off (build 26: no VR control, the choice stuck).
SOMVR_VERBS_LASTWORDS=on
# The Eliminate's struggle (the captain's own last chance, 'PC_Bip_Finisher_*') answered as Talion's: the hand steers, a
# thrust in the ring presses. Off: =off (build 26: left alone, lost - he gets up whole).
SOMVR_STRUGGLE_FINISHER=on
